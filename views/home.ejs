  <style>
    body {
      box-sizing: border-box;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
    }

    body {
      font-family: 'Orbitron', sans-serif;
      background: #0a0015;
      color: #00ffff;
      overflow-x: hidden;
      overflow-y: auto;
    }

    .page-wrapper {
      width: 100%;
      min-height: 100%;
      position: relative;
    }

    .animated-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(45deg, #0a0015 0%, #1a0030 50%, #0a0015 100%);
      background-size: 400% 400%;
      animation: gradientShift 15s ease infinite;
      z-index: 0;
    }

    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .particles {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
      pointer-events: none;
    }

    .particle {
      position: absolute;
      width: 3px;
      height: 3px;
      background: #00ffff;
      border-radius: 50%;
      box-shadow: 0 0 15px #00ffff;
      animation: float 20s infinite ease-in-out;
      opacity: 0.7;
    }

    .particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; animation-duration: 18s; }
    .particle:nth-child(2) { left: 25%; top: 60%; animation-delay: 2s; animation-duration: 22s; }
    .particle:nth-child(3) { left: 45%; top: 30%; animation-delay: 4s; animation-duration: 20s; }
    .particle:nth-child(4) { left: 65%; top: 70%; animation-delay: 1s; animation-duration: 19s; }
    .particle:nth-child(5) { left: 80%; top: 40%; animation-delay: 3s; animation-duration: 21s; }
    .particle:nth-child(6) { left: 15%; top: 80%; animation-delay: 5s; animation-duration: 23s; }
    .particle:nth-child(7) { left: 55%; top: 15%; animation-delay: 2.5s; animation-duration: 17s; }
    .particle:nth-child(8) { left: 75%; top: 85%; animation-delay: 4.5s; animation-duration: 24s; }
    .particle:nth-child(9) { left: 35%; top: 50%; animation-delay: 1.5s; animation-duration: 19s; }
    .particle:nth-child(10) { left: 90%; top: 25%; animation-delay: 3.5s; animation-duration: 21s; }
    .particle:nth-child(11) { left: 5%; top: 45%; animation-delay: 6s; animation-duration: 20s; }
    .particle:nth-child(12) { left: 50%; top: 90%; animation-delay: 2s; animation-duration: 18s; }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; }
      25% { transform: translate(30px, -40px) scale(1.3); opacity: 0.9; }
      50% { transform: translate(-20px, 30px) scale(0.9); opacity: 0.5; }
      75% { transform: translate(35px, 20px) scale(1.2); opacity: 0.8; }
    }

    header {
      position: relative;
      z-index: 10;
      width: 100%;
      padding: 1.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(10, 0, 21, 0.8);
      backdrop-filter: blur(10px);
      border-bottom: 2px solid #8000ff;
      box-shadow: 0 5px 30px rgba(128, 0, 255, 0.3);
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 900;
      letter-spacing: 0.2rem;
      color: #00ffff;
      text-shadow: 0 0 20px #00ffff, 0 0 40px #8000ff;
    }

    nav {
      display: flex;
      gap: 2rem;
    }

    .nav-link {
      color: #8000ff;
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.05rem;
      text-transform: uppercase;
      padding: 0.6rem 1.2rem;
      border: 2px solid transparent;
      border-radius: 20px;
      transition: all 0.3s ease;
    }

    .nav-link:hover {
      color: #00ffff;
      border-color: #00ffff;
      text-shadow: 0 0 10px #00ffff;
      box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
    }

    .hero-section {
      position: relative;
      z-index: 2;
      width: 100%;
      min-height: 90%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 4rem 2rem;
      text-align: center;
    }

    .logo-title {
      font-size: 4rem;
      font-weight: 900;
      letter-spacing: 0.3rem;
      text-transform: uppercase;
      color: #00ffff;
      text-shadow: 
        0 0 10px #00ffff,
        0 0 20px #00ffff,
        0 0 30px #00ffff,
        0 0 50px #8000ff,
        0 0 80px #8000ff;
      margin-bottom: 1.5rem;
      animation: flicker 3s ease-in-out 1;
      position: relative;
    }

    .logo-title::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: 3px;
      background: linear-gradient(90deg, transparent, #00ffff, transparent);
      box-shadow: 0 0 15px #00ffff;
    }

    @keyframes flicker {
      0%, 100% { opacity: 1; }
      10% { opacity: 0.8; }
      20% { opacity: 1; }
      30% { opacity: 0.6; }
      40% { opacity: 1; }
      50% { opacity: 0.9; }
      60% { opacity: 1; }
    }

    .subtitle {
      font-size: 1.3rem;
      color: #8000ff;
      text-shadow: 0 0 15px #8000ff;
      margin-bottom: 3.5rem;
      font-weight: 400;
      letter-spacing: 0.1rem;
      max-width: 700px;
    }

    .cta-button {
      display: inline-block;
      padding: 1.5rem 4.5rem;
      font-size: 1.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.25rem;
      color: #000000;
      background: #00ffff;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      text-decoration: none;
      box-shadow: 
        0 0 25px #00ffff,
        0 0 50px #00ffff,
        inset 0 0 25px rgba(0, 255, 255, 0.3);
      transition: all 0.3s ease;
      animation: pulse 2s ease-in-out infinite;
      margin-bottom: 3rem;
      font-family: 'Orbitron', sans-serif;
    }

    @keyframes pulse {
      0%, 100% { 
        box-shadow: 
          0 0 25px #00ffff,
          0 0 50px #00ffff,
          inset 0 0 25px rgba(0, 255, 255, 0.3);
      }
      50% { 
        box-shadow: 
          0 0 35px #00ffff,
          0 0 70px #00ffff,
          0 0 100px #00ffff,
          inset 0 0 35px rgba(0, 255, 255, 0.5);
      }
    }

    .cta-button:hover {
      transform: scale(1.1);
      box-shadow: 
        0 0 50px #00ffff,
        0 0 100px #00ffff,
        0 0 150px #00ffff,
        inset 0 0 40px rgba(0, 255, 255, 0.6);
    }

    .why-play-intro {
      position: relative;
      z-index: 2;
      width: 100%;
      padding: 5rem 2rem;
      background: rgba(10, 0, 21, 0.8);
      backdrop-filter: blur(10px);
      text-align: center;
    }

    .section-title {
      font-size: 3.5rem;
      font-weight: 900;
      text-align: center;
      color: #00ffff;
      text-shadow: 0 0 20px #00ffff, 0 0 40px #8000ff;
      margin-bottom: 2rem;
      letter-spacing: 0.15rem;
      text-transform: uppercase;
      animation: fadeInDown 1s ease;
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .intro-text {
      font-size: 1.2rem;
      color: #8000ff;
      text-shadow: 0 0 10px #8000ff;
      max-width: 800px;
      margin: 0 auto 3rem;
      line-height: 1.8;
    }

    .scroll-indicator {
      display: inline-block;
      color: #00ffff;
      font-size: 2rem;
      animation: bounce 2s infinite;
    }

    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% {
        transform: translateY(0);
      }
      40% {
        transform: translateY(-15px);
      }
      60% {
        transform: translateY(-7px);
      }
    }

    .feature-section {
      position: relative;
      z-index: 2;
      width: 100%;
      min-height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6rem 2rem;
      scroll-snap-align: start;
      opacity: 0;
      transform: translateY(50px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .feature-section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .feature-section:nth-child(odd) {
      background: linear-gradient(135deg, rgba(10, 0, 21, 0.9) 0%, rgba(26, 0, 48, 0.7) 100%);
    }

    .feature-section:nth-child(even) {
      background: linear-gradient(135deg, rgba(26, 0, 48, 0.7) 0%, rgba(10, 0, 21, 0.9) 100%);
    }

    .feature-content {
      max-width: 1200px;
      display: flex;
      align-items: center;
      gap: 4rem;
      width: 100%;
    }

    .feature-section:nth-child(even) .feature-content {
      flex-direction: row-reverse;
    }

    .feature-visual {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .feature-icon-large {
      width: 250px;
      height: 250px;
      border-radius: 50%;
      border: 4px solid #00ffff;
      box-shadow: 
        0 0 40px rgba(0, 255, 255, 0.6),
        inset 0 0 60px rgba(0, 255, 255, 0.2);
      animation: float-icon 4s ease-in-out infinite;
      transition: transform 0.3s ease;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .feature-icon-large::before {
      content: '';
      position: absolute;
      width: 60%;
      height: 60%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 255, 255, 0.3) 0%, transparent 70%);
      animation: pulse-circle 3s ease-in-out infinite;
    }

    .feature-icon-large::after {
      content: '';
      position: absolute;
      width: 80%;
      height: 80%;
      border: 2px solid rgba(128, 0, 255, 0.4);
      border-radius: 50%;
      animation: rotate-ring 8s linear infinite;
    }

    @keyframes pulse-circle {
      0%, 100% {
        transform: scale(1);
        opacity: 0.5;
      }
      50% {
        transform: scale(1.2);
        opacity: 1;
      }
    }

    @keyframes rotate-ring {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }

    .feature-section:hover .feature-icon-large {
      transform: scale(1.1);
      box-shadow: 
        0 0 60px rgba(0, 255, 255, 0.8),
        inset 0 0 80px rgba(0, 255, 255, 0.3);
    }

    @keyframes float-icon {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    .feature-text {
      flex: 1;
      padding: 2rem;
    }

    .feature-number {
      font-size: 1rem;
      color: #8000ff;
      text-transform: uppercase;
      letter-spacing: 0.2rem;
      margin-bottom: 1rem;
      font-weight: 600;
    }

    .feature-title {
      font-size: 3rem;
      font-weight: 900;
      color: #00ffff;
      margin-bottom: 1.5rem;
      text-shadow: 0 0 20px rgba(0, 255, 255, 0.6);
      letter-spacing: 0.1rem;
      line-height: 1.2;
    }

    .feature-description {
      font-size: 1.3rem;
      color: #b8b8ff;
      line-height: 1.8;
      font-weight: 400;
      text-shadow: 0 0 5px rgba(184, 184, 255, 0.3);
    }

    .feature-glow-box {
      position: absolute;
      width: 300px;
      height: 300px;
      border: 3px solid #8000ff;
      border-radius: 50%;
      animation: rotate-glow 10s linear infinite;
      box-shadow: 0 0 40px rgba(128, 0, 255, 0.5), inset 0 0 40px rgba(128, 0, 255, 0.2);
    }

    @keyframes rotate-glow {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }

    .progress-indicator {
      position: fixed;
      top: 50%;
      right: 2rem;
      transform: translateY(-50%);
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    .progress-line {
      width: 3px;
      height: 100%;
      background: rgba(128, 0, 255, 0.3);
      position: relative;
    }

    .progress-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      background: linear-gradient(180deg, #00ffff 0%, #8000ff 100%);
      box-shadow: 0 0 20px #00ffff;
      transition: height 0.5s ease;
      height: 0%;
    }

    .progress-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(128, 0, 255, 0.5);
      border: 2px solid #8000ff;
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      z-index: 2;
      margin: 0.8rem 0;
    }

    .progress-dot.active {
      background: #00ffff;
      border-color: #00ffff;
      box-shadow: 0 0 20px #00ffff;
      transform: scale(1.8);
    }

    .progress-dot:hover {
      background: #00ffff;
      border-color: #00ffff;
      box-shadow: 0 0 15px #00ffff;
      transform: scale(1.4);
    }

    .cta-section {
      position: relative;
      z-index: 2;
      width: 100%;
      padding: 5rem 2rem;
      text-align: center;
    }

    .cta-section h2 {
      font-size: 2.5rem;
      font-weight: 900;
      color: #00ffff;
      text-shadow: 0 0 20px #00ffff;
      margin-bottom: 2rem;
      letter-spacing: 0.1rem;
    }

    .cta-section p {
      font-size: 1.2rem;
      color: #8000ff;
      text-shadow: 0 0 10px #8000ff;
      margin-bottom: 3rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
