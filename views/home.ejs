  </div>
  <script>
    const defaultConfig = {
      main_title: "WELCOME TO NEONARC GAMES",
      subtitle: "Your first 100 credits await. Power on. Play bright.",
      cta_button_text: "JOIN TODAY",
      explore_link_text: "Explore Games",
      leaderboard_link_text: "Leaderboard",
      login_link_text: "Login",
      why_play_title: "Why You Should Play on NeonArc Games",
      feature_1_title: "Skill Meets Light",
      feature_1_desc: "Every game blends timing, reflex, and logic — it's not just luck; it's how fast your mind reacts when the lights pulse.",
      feature_2_title: "Earn Credits, Not Just Points",
      feature_2_desc: "Every spin, tap, or play earns you real in-game credits that unlock new modes, bonuses, and ranks.",
      feature_3_title: "Exclusive Futuristic Titles",
      feature_3_desc: "From Rocket Rush to StackJack and Pulse Cash, every title is original — built to glow, thrill, and challenge you.",
      footer_text: "© 2025 NeonArc Games — Powered by Light and Logic ⚡",
      background_color: "#0a0015",
      surface_color: "#8000ff",
      text_color: "#b8b8ff",
      primary_glow_color: "#00ffff",
      accent_color: "#8000ff"
    };

    async function onConfigChange(config) {
      const mainTitleEl = document.getElementById('mainTitle');
      const subtitleEl = document.getElementById('subtitle');
      const ctaButtons = document.querySelectorAll('.cta-button');
      const navExploreEl = document.getElementById('navExplore');
      const navLeaderboardEl = document.getElementById('navLeaderboard');
      const navLoginEl = document.getElementById('navLogin');
      const whyPlayTitleEl = document.getElementById('whyPlayTitle');
      const feature1TitleEl = document.getElementById('feature1Title');
      const feature1DescEl = document.getElementById('feature1Desc');
      const feature2TitleEl = document.getElementById('feature2Title');
      const feature2DescEl = document.getElementById('feature2Desc');
      const feature3TitleEl = document.getElementById('feature3Title');
      const feature3DescEl = document.getElementById('feature3Desc');
      const footerEl = document.getElementById('footer');

      mainTitleEl.textContent = config.main_title || defaultConfig.main_title;
      subtitleEl.textContent = config.subtitle || defaultConfig.subtitle;
      ctaButtons.forEach(btn => {
        if (btn.id === 'ctaButton') {
          btn.textContent = config.cta_button_text || defaultConfig.cta_button_text;
        }
      });
      navExploreEl.textContent = config.explore_link_text || defaultConfig.explore_link_text;
      navLeaderboardEl.textContent = config.leaderboard_link_text || defaultConfig.leaderboard_link_text;
      navLoginEl.textContent = config.login_link_text || defaultConfig.login_link_text;
      whyPlayTitleEl.textContent = config.why_play_title || defaultConfig.why_play_title;
      feature1TitleEl.textContent = config.feature_1_title || defaultConfig.feature_1_title;
      feature1DescEl.textContent = config.feature_1_desc || defaultConfig.feature_1_desc;
      feature2TitleEl.textContent = config.feature_2_title || defaultConfig.feature_2_title;
      feature2DescEl.textContent = config.feature_2_desc || defaultConfig.feature_2_desc;
      feature3TitleEl.textContent = config.feature_3_title || defaultConfig.feature_3_title;
      feature3DescEl.textContent = config.feature_3_desc || defaultConfig.feature_3_desc;
      footerEl.innerHTML = config.footer_text || defaultConfig.footer_text;

      const backgroundColor = config.background_color || defaultConfig.background_color;
      const surfaceColor = config.surface_color || defaultConfig.surface_color;
      const textColor = config.text_color || defaultConfig.text_color;
      const primaryGlow = config.primary_glow_color || defaultConfig.primary_glow_color;
      const accentColor = config.accent_color || defaultConfig.accent_color;

      document.body.style.background = backgroundColor;
      document.querySelector('.animated-background').style.background = `linear-gradient(45deg, ${backgroundColor} 0%, #1a0030 50%, ${backgroundColor} 100%)`;

      mainTitleEl.style.color = primaryGlow;
      mainTitleEl.style.textShadow = `0 0 10px ${primaryGlow}, 0 0 20px ${primaryGlow}, 0 0 30px ${primaryGlow}, 0 0 50px ${accentColor}, 0 0 80px ${accentColor}`;

      subtitleEl.style.color = accentColor;
      subtitleEl.style.textShadow = `0 0 15px ${accentColor}`;

      ctaButtons.forEach(btn => {
        btn.style.backgroundColor = primaryGlow;
      });

      const navLinks = document.querySelectorAll('.nav-link');
      navLinks.forEach(link => {
        link.style.color = accentColor;
      });

      const sectionTitles = document.querySelectorAll('.section-title');
      sectionTitles.forEach(title => {
        title.style.color = primaryGlow;
        title.style.textShadow = `0 0 20px ${primaryGlow}, 0 0 40px ${accentColor}`;
      });

      const featureTitles = document.querySelectorAll('.feature-title');
      featureTitles.forEach(title => {
        title.style.color = primaryGlow;
        title.style.textShadow = `0 0 10px ${primaryGlow}`;
      });

      const featureDescriptions = document.querySelectorAll('.feature-description');
      featureDescriptions.forEach(desc => {
        desc.style.color = textColor;
      });

      const featureCards = document.querySelectorAll('.feature-card');
      featureCards.forEach(card => {
        card.style.borderColor = surfaceColor;
        card.style.background = `rgba(128, 0, 255, 0.1)`;
      });

      footerEl.style.color = accentColor;
      footerEl.style.textShadow = `0 0 5px ${accentColor}`;

      const particles = document.querySelectorAll('.particle');
      particles.forEach(particle => {
        particle.style.background = primaryGlow;
        particle.style.boxShadow = `0 0 15px ${primaryGlow}`;
      });
    }

    function mapToCapabilities(config) {
      return {
        recolorables: [
          {
            get: () => config.background_color || defaultConfig.background_color,
            set: (value) => {
              config.background_color = value;
              window.elementSdk.setConfig({ background_color: value });
            }
          },
          {
            get: () => config.surface_color || defaultConfig.surface_color,
            set: (value) => {
              config.surface_color = value;
              window.elementSdk.setConfig({ surface_color: value });
            }
          },
          {
            get: () => config.text_color || defaultConfig.text_color,
            set: (value) => {
              config.text_color = value;
              window.elementSdk.setConfig({ text_color: value });
            }
          },
          {
            get: () => config.primary_glow_color || defaultConfig.primary_glow_color,
            set: (value) => {
              config.primary_glow_color = value;
              window.elementSdk.setConfig({ primary_glow_color: value });
            }
          },
          {
            get: () => config.accent_color || defaultConfig.accent_color,
            set: (value) => {
              config.accent_color = value;
              window.elementSdk.setConfig({ accent_color: value });
            }
          }
        ],
        borderables: [],
        fontEditable: undefined,
        fontSizeable: undefined
      };
    }

    function mapToEditPanelValues(config) {
      return new Map([
        ["main_title", config.main_title || defaultConfig.main_title],
        ["subtitle", config.subtitle || defaultConfig.subtitle],
        ["cta_button_text", config.cta_button_text || defaultConfig.cta_button_text],
        ["explore_link_text", config.explore_link_text || defaultConfig.explore_link_text],
        ["leaderboard_link_text", config.leaderboard_link_text || defaultConfig.leaderboard_link_text],
        ["login_link_text", config.login_link_text || defaultConfig.login_link_text],
        ["why_play_title", config.why_play_title || defaultConfig.why_play_title],
        ["feature_1_title", config.feature_1_title || defaultConfig.feature_1_title],
        ["feature_1_desc", config.feature_1_desc || defaultConfig.feature_1_desc],
        ["feature_2_title", config.feature_2_title || defaultConfig.feature_2_title],
        ["feature_2_desc", config.feature_2_desc || defaultConfig.feature_2_desc],
        ["feature_3_title", config.feature_3_title || defaultConfig.feature_3_title],
        ["feature_3_desc", config.feature_3_desc || defaultConfig.feature_3_desc],
        ["footer_text", config.footer_text || defaultConfig.footer_text]
      ]);
    }

    if (window.elementSdk) {
      window.elementSdk.init({
        defaultConfig,
        onConfigChange,
        mapToCapabilities,
        mapToEditPanelValues
      });
    }

    // Scroll animations and progress indicator
    const featureSections = document.querySelectorAll('.feature-section');
    const progressDots = document.querySelectorAll('.progress-dot');
    const allSections = [document.querySelector('.hero-section'), ...featureSections];

    // Intersection Observer for scroll animations
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.3
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          
          // Update progress indicator
          const featureNum = entry.target.dataset.feature;
          if (featureNum) {
            progressDots.forEach(dot => dot.classList.remove('active'));
            const activeDot = document.querySelector(`.progress-dot[data-section="${featureNum}"]`);
            if (activeDot) activeDot.classList.add('active');
          } else if (entry.target.classList.contains('hero-section')) {
            progressDots.forEach(dot => dot.classList.remove('active'));
            progressDots[0].classList.add('active');
          }
        }
      });
    }, observerOptions);

    // Observe all feature sections
    featureSections.forEach(section => observer.observe(section));
    observer.observe(document.querySelector('.hero-section'));

    // Progress dot click navigation
    progressDots.forEach(dot => {
      dot.addEventListener('click', () => {
        const sectionIndex = parseInt(dot.dataset.section);
        if (sectionIndex === 0) {
          document.querySelector('.hero-section').scrollIntoView({ behavior: 'smooth' });
        } else {
          const targetSection = document.querySelector(`.feature-section[data-feature="${sectionIndex}"]`);
          if (targetSection) {
            targetSection.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    // Smooth scroll for internal links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Parallax effect for particles on scroll
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;
      const particles = document.querySelectorAll('.particle');

      particles.forEach((particle, index) => {
        const speed = (index % 3 + 1) * 0.1;
        const yPos = -(currentScroll * speed);
        particle.style.transform = `translateY(${yPos}px)`;
      });

      lastScroll = currentScroll;
    });
  </script>
