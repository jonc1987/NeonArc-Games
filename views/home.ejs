      }

      .section-title {
        font-size: 2rem;
      }

      .feature-content {
        flex-direction: column !important;
        gap: 2rem;
      }

      .feature-icon-large {
        width: 180px;
        height: 180px;
      }

      .feature-title {
        font-size: 2rem;
      }

      .feature-description {
        font-size: 1.1rem;
      }

      .feature-glow-box {
        width: 200px;
        height: 200px;
      }

      .progress-indicator {
        right: 1rem;
      }

      .cta-section h2 {
        font-size: 1.8rem;
      }
    }

    @media (max-width: 480px) {
      .logo {
        font-size: 1.3rem;
      }

      .logo-title {
        font-size: 1.6rem;
        letter-spacing: 0.1rem;
      }

      .subtitle {
        font-size: 0.9rem;
      }

      .cta-button {
        padding: 1rem 2.5rem;
        font-size: 1.2rem;
      }

      .section-title {
        font-size: 1.6rem;
      }

      .feature-icon-large {
        width: 140px;
        height: 140px;
      }

      .feature-title {
        font-size: 1.5rem;
      }

      .feature-description {
        font-size: 1rem;
      }

      .feature-number {
        font-size: 0.85rem;
      }

      .progress-indicator {
        display: none;
      }
    }
  </style>
