      async function joinMultiplayerSession(sessionId) {
        if (!sessionId) return;
        try {
          const response = await fetch(`/api/multiplayer/session/${encodeURIComponent(sessionId)}/join`, {
            method: 'POST',
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setFriendlySessionStatus(payload.error || 'Unable to join shared session.', true);
            return;
          }
          multiplayerSessionId = sessionId;
          multiplayerRole = payload.role;
          multiplayerGame = payload.game || multiplayerGame;
          const partnerName = payload.partner?.username;
          if (multiplayerRole === 'host') {
            updateFriendlyParticipants({
              host: 'You',
              guest: partnerName || 'Guest',
            });
          } else {
            updateFriendlyParticipants({
              host: partnerName || 'Host',
              guest: 'You',
            });
          }
          const friendPlaceholder = initialFriendlyParams.friend || partnerName || 'Pilot';
          setFriendlySessionLink(friendPlaceholder, multiplayerGame);
          setFriendlySessionStatus(`Session active (${multiplayerRole}).`);
          connectMultiplayerSocket(sessionId);
        } catch (error) {
          console.error('Failed to join multiplayer session', error);
          setFriendlySessionStatus('Unable to join session.', true);
        }
      }

      async function createFriendlyMultiplayerSession(friend, game) {
        const label = getFriendlyGameLabel(game);
        setFriendlySessionStatus(`Creating ${label} session with ${friend}...`);
        try {
          const response = await fetch('/api/multiplayer/session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: friend, game }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setFriendlySessionStatus(payload.error || 'Unable to create multiplayer session.', true);
            return;
          }
          multiplayerSessionId = payload.sessionId;
          multiplayerGame = payload.game || game;
          setFriendlySessionBanner(`Playing ${payload.label || label} vs the computer with ${friend}.`);
          setFriendlySessionLink(friend, payload.game, payload.link);
          setFriendlySessionStatus(`Session ready. Share link or wait for ${friend}.`);
          await joinMultiplayerSession(payload.sessionId);
          return payload;
        } catch (error) {
          console.error('Failed to create multiplayer session', error);
          setFriendlySessionStatus('Failed to create session.', true);
        }
      }

      function connectMultiplayerSocket(sessionId) {
        if (!sessionId) return;
        if (multiplayerSocket) {
          multiplayerSocket.close();
        }
        const wsScheme = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const socket = new WebSocket(
          `${wsScheme}://${window.location.host}/ws/multiplayer?session=${encodeURIComponent(sessionId)}`,
        );
        multiplayerSocket = socket;
        socket.addEventListener('open', () => {
          setFriendlySessionStatus('Multiplayer signaling connected.');
        });
        socket.addEventListener('message', (event) => {
          try {
            const data = JSON.parse(event.data);
            if (data?.type === 'session.participants') {
              updateFriendlyParticipants(data.participants);
              appendFriendlyEvent({
                event: 'session.update',
                message: `Status: ${data.status || 'waiting'}`,
              });
            }
            if (data?.type === 'game.event') {
              appendFriendlyEvent(data);
            }
            if (data?.type?.startsWith('signal.')) {
              handleMultiplayerSignal(data).catch((error) => {
                console.error('Signal handling failed', error);
              });
            }
          } catch (error) {
            console.error('Multiplayer socket parse error', error);
          }
        });
        socket.addEventListener('close', () => {
          multiplayerSocket = null;
          setFriendlySessionStatus('Session disconnected.', true);
          appendFriendlyEvent({ event: 'session.closed', message: 'Connection lost.' });
        });
        socket.addEventListener('error', () => {
          setFriendlySessionStatus('Multiplayer signaling error.', true);
        });
      }

      function createMultiplayerPeerConnection() {
        const pc = new RTCPeerConnection();
        pc.addEventListener('icecandidate', (event) => {
          if (event.candidate) {
            multiplayerSocket?.send(
              JSON.stringify({ type: 'signal.candidate', candidate: event.candidate }),
            );
          }
        });
        pc.addEventListener('track', (event) => {
          if (friendlyRemoteVideo) {
            friendlyRemoteVideo.srcObject = event.streams[0];
          }
        });
        return pc;
      }

      async function handleMultiplayerSignal(payload) {
        if (!payload?.type) return;
        if (!multiplayerPeerConnection) {
          multiplayerPeerConnection = createMultiplayerPeerConnection();
        }
        if (payload.type === 'signal.offer' && payload.offer) {
          await multiplayerPeerConnection.setRemoteDescription(new RTCSessionDescription(payload.offer));
          const answer = await multiplayerPeerConnection.createAnswer();
          await multiplayerPeerConnection.setLocalDescription(answer);
          multiplayerSocket?.send(JSON.stringify({ type: 'signal.answer', answer }));
        } else if (payload.type === 'signal.answer' && payload.answer) {
          await multiplayerPeerConnection.setRemoteDescription(
            new RTCSessionDescription(payload.answer),
          );
        } else if (payload.type === 'signal.candidate' && payload.candidate) {
          await multiplayerPeerConnection.addIceCandidate(new RTCIceCandidate(payload.candidate));
        }
      }

      async function startMultiplayerCall() {
        if (!multiplayerSessionId || !multiplayerSocket) {
          setFriendlySessionStatus('Join a session before starting a call.', true);
          return;
        }
        if (!multiplayerPeerConnection) {
          multiplayerPeerConnection = createMultiplayerPeerConnection();
        }
        if (!multiplayerLocalStream) {
          try {
            multiplayerLocalStream = await navigator.mediaDevices.getUserMedia({
              audio: true,
              video: true,
            });
            if (friendlyLocalVideo) {
              friendlyLocalVideo.srcObject = multiplayerLocalStream;
            }
            multiplayerLocalStream.getTracks().forEach((track) => {
              multiplayerPeerConnection.addTrack(track, multiplayerLocalStream);
            });
          } catch (error) {
            console.error('Media capture failed', error);
            setFriendlySessionStatus('Unable to access camera/mic.', true);
            return;
          }
        }
        try {
          const offer = await multiplayerPeerConnection.createOffer();
          await multiplayerPeerConnection.setLocalDescription(offer);
          multiplayerSocket.send(JSON.stringify({ type: 'signal.offer', offer }));
          setFriendlySessionStatus('Video call starting...');
        } catch (error) {
          console.error('Call start failed', error);
          setFriendlySessionStatus('Unable to start video call.', true);
        }
      }

