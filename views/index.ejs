        } catch (error) {
          console.error('Failed to purchase item', error);
          setAccountStatus('Unable to complete purchase right now.', true);
        }
      }

      function renderQuestList(quests = [], nextReset) {
        if (!questListEl) return;
        questListEl.innerHTML = '';
        if (!Array.isArray(quests) || quests.length === 0) {
          const empty = document.createElement('li');
          empty.textContent = 'Quest board is empty.';
          empty.style.opacity = '0.6';
          questListEl.appendChild(empty);
          if (questStatusEl) {
            questStatusEl.textContent = nextReset
              ? `Resets ${new Date(nextReset).toLocaleString()}.`
              : 'Quest board refreshing.';
          }
          return;
        }

        quests.forEach((quest) => {
          const card = document.createElement('li');
          card.className = 'quest-card';

          const header = document.createElement('div');
          header.style.display = 'flex';
          header.style.justifyContent = 'space-between';
          header.style.alignItems = 'baseline';
          header.style.gap = '12px';

          const title = document.createElement('strong');
          title.textContent = quest.title;

          const statusBadge = document.createElement('span');
          statusBadge.textContent = quest.claimed ? 'Claimed' : quest.completed ? 'Ready' : 'In Progress';
          statusBadge.style.fontSize = '11px';
          statusBadge.style.letterSpacing = '0.2em';
          statusBadge.style.textTransform = 'uppercase';
          statusBadge.style.color = quest.claimed ? '#f7c6ff' : '#9dd8ff';

          header.appendChild(title);
          header.appendChild(statusBadge);
          card.appendChild(header);

          const desc = document.createElement('p');
          desc.textContent = quest.description;
          desc.style.margin = '4px 0';
          card.appendChild(desc);

          const reward = document.createElement('div');
          reward.textContent = `Reward: ${formatCredits(quest.reward)}`;
          reward.style.fontSize = '13px';
          reward.style.color = 'rgba(234, 249, 255, 0.8)';
          card.appendChild(reward);

          const progressWrap = document.createElement('div');
          progressWrap.className = 'quest-progress';
          const progressFill = document.createElement('div');
          progressFill.className = 'quest-progress-fill';
          const percent = Math.min(100, Math.max(0, quest.percent || 0));
          progressFill.style.width = `${percent}%`;
          progressWrap.appendChild(progressFill);
          card.appendChild(progressWrap);

          const progressText = document.createElement('div');
          progressText.style.fontSize = '13px';
          progressText.style.color = '#c6d8f3';
          progressText.textContent = `${quest.progress}/${quest.goal} ${quest.rewardLabel}`;
          card.appendChild(progressText);

          const button = document.createElement('button');
          button.type = 'button';
          if (quest.claimed) {
            button.textContent = 'Claimed';
            button.disabled = true;
          } else if (quest.completed) {
            button.textContent = 'Claim Reward';
            button.addEventListener('click', () => claimQuestReward(quest));
          } else {
            button.textContent = 'In Progress';
            button.disabled = true;
          }
          card.appendChild(button);

          questListEl.appendChild(card);
        });

        if (questStatusEl) {
          questStatusEl.textContent = nextReset
            ? `Resets ${new Date(nextReset).toLocaleString()}.`
            : 'Quest board ready.';
        }
      }

