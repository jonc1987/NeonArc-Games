      .perception-stage {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(24px, 4vw, 40px);
        background: radial-gradient(circle at 30% 20%, rgba(0, 240, 255, 0.08), rgba(0, 0, 0, 0.75));
        overflow: hidden;
        aspect-ratio: auto;
        min-height: clamp(360px, 45vw, 620px);
      }

      .perception-stage::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, transparent, rgba(110, 255, 236, 0.08), transparent);
        opacity: 0;
        transform: translateX(-80%);
      }

      .perception-stage.live::after {
        animation: perceptionShimmer 3.6s linear infinite;
      }

      .perception-stage.revealing::after {
        opacity: 1;
        animation: perceptionReveal 0.9s ease forwards;
      }

      .perception-card-grid {
        position: relative;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: clamp(16px, 3vw, 26px);
        width: 100%;
      }

      .perception-placeholder {
        grid-column: 1 / -1;
        padding: 30px;
        border-radius: 20px;
        text-align: center;
        font-size: 15px;
        color: rgba(255, 255, 255, 0.65);
        border: 1px dashed rgba(110, 255, 236, 0.3);
        background: rgba(0, 15, 30, 0.45);
      }

      .perception-card {
        position: relative;
        border-radius: 18px;
        padding: 18px;
        border: 1px solid rgba(110, 255, 236, 0.25);
        background: linear-gradient(135deg, rgba(10, 30, 50, 0.8), rgba(0, 0, 0, 0.8));
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.55);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border 0.3s ease;
        cursor: default;
      }

      .perception-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 30% 20%, rgba(0, 255, 204, 0.1), transparent 60%);
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }

      .perception-card:hover {
        transform: perspective(500px) rotateX(4deg) rotateY(-2deg) translateY(-4px);
        box-shadow: 0 30px 50px rgba(0, 255, 236, 0.15);
      }

      .perception-card:hover::before {
        opacity: 1;
      }

      .perception-card.revealed.truth {
        border-color: rgba(110, 255, 200, 0.65);
        box-shadow: 0 0 25px rgba(110, 255, 200, 0.35);
      }

      .perception-card.revealed.illusion {
        border-color: rgba(255, 110, 160, 0.8);
        box-shadow: 0 0 30px rgba(255, 60, 120, 0.35);
        animation: illusionPulse 1.8s ease-in-out infinite;
      }

      .perception-card-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 140px;
