      async function refreshDailyWheelStatus() {
        if (!requireActiveSession()) return;
        setGlowWheelLabel('Checking');
        if (dailyWheelStatusEl) {
          dailyWheelStatusEl.textContent = 'Checking availability...';
          dailyWheelStatusEl.style.color = 'rgba(234, 249, 255, 0.72)';
        }
        try {
          const response = await fetch('/api/daily-wheel');
          if (response.status === 401) {
            clearAccountData('Session expired. Please log in again.', true);
            setAuthStatus('Session expired. Please log in again.', true);
            return;
          }
          if (!response.ok) {
            if (dailyWheelStatusEl) {
              dailyWheelStatusEl.textContent = 'Unable to load wheel status.';
              dailyWheelStatusEl.style.color = '#ff9bb3';
            }
            return;
          }
          const payload = await response.json();
          updateDailyWheelUI(payload);
        } catch (error) {
          console.error('Failed to load daily wheel', error);
          setGlowWheelLabel('Error');
          if (dailyWheelStatusEl) {
            dailyWheelStatusEl.textContent = 'Could not reach the wheel service.';
            dailyWheelStatusEl.style.color = '#ff9bb3';
          }
        }
      }

      async function spinDailyWheel() {
        if (!requireActiveSession()) return;
        triggerGlowWheelSpin();
        setGlowWheelLabel('Spinning');
        if (dailyWheelStatusEl) {
          dailyWheelStatusEl.textContent = 'Spinning...';
          dailyWheelStatusEl.style.color = 'rgba(234, 249, 255, 0.72)';
        }
        try {
          const response = await fetch('/api/daily-wheel', { method: 'POST' });
          if (response.status === 401) {
            clearAccountData('Session expired. Please log in again.', true);
            setAuthStatus('Session expired. Please log in again.', true);
            stopGlowWheelSpin();
            return;
          }
          if (response.status === 429) {
            const payload = await response.json();
            updateDailyWheelUI(payload);
            stopGlowWheelSpin();
            if (dailyWheelStatusEl) {
              const nextWindow = payload?.nextEligibleAt
                ? new Date(payload.nextEligibleAt).toLocaleString()
                : 'later today';
              dailyWheelStatusEl.textContent = `Already spun. Next spin after ${nextWindow}.`;
              dailyWheelStatusEl.style.color = '#ff9bb3';
            }
            setGlowWheelLabel('Locked');
            return;
          }
          if (!response.ok) {
            stopGlowWheelSpin();
            if (dailyWheelStatusEl) {
              dailyWheelStatusEl.textContent = 'Spin failed.';
              dailyWheelStatusEl.style.color = '#ff9bb3';
            }
            setGlowWheelLabel('Retry');
            return;
          }
          const payload = await response.json();
          updateDailyWheelUI({
            lastReward: payload?.reward,
            nextEligibleAt: payload?.nextEligibleAt,
          });
          if (dailyWheelStatusEl) {
            dailyWheelStatusEl.textContent = `Wheel awarded ${formatCredits(payload?.reward)}.`;
          }
          celebrateGlowWheel(formatCredits(payload?.reward));
          recordQuestEvent('daily_spin');
          await refreshAccountFromServer();
        } catch (error) {
          console.error('Failed to spin daily wheel', error);
          stopGlowWheelSpin();
          if (dailyWheelStatusEl) {
            dailyWheelStatusEl.textContent = 'Could not spin the wheel.';
            dailyWheelStatusEl.style.color = '#ff9bb3';
          }
          setGlowWheelLabel('Error');
        }
      }

