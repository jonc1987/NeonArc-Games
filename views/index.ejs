      function connectChatSocket() {
        if (chatSocket) return;
        const wsUrl = `${chatWsScheme}://${window.location.host}/ws/chat`;
        chatSocket = new WebSocket(wsUrl);
        chatSocket.addEventListener('open', () => {
          setChatStatus('Crew chat connected.');
          refreshChatHistory();
        });
        chatSocket.addEventListener('message', (event) => {
          try {
            const payload = JSON.parse(event.data);
            if (payload?.type === 'chat.message') {
              appendChatMessage(payload.message);
            }
          } catch (error) {
            console.error('Chat socket parse error', error);
          }
        });
        chatSocket.addEventListener('close', () => {
          chatSocket = null;
          setChatStatus('Chat disconnected. Reconnecting...');
          if (chatReconnectTimer) clearTimeout(chatReconnectTimer);
          chatReconnectTimer = setTimeout(connectChatSocket, 3000);
        });
        chatSocket.addEventListener('error', () => {
          setChatStatus('Chat connection error.', true);
        });
      }

      function shutdownChatSocket() {
        if (chatReconnectTimer) {
          clearTimeout(chatReconnectTimer);
          chatReconnectTimer = null;
        }
        if (chatSocket) {
          chatSocket.close();
          chatSocket = null;
        }
      }

      function toggleChatPanel(forceOpen) {
        if (!chatPanel) return;
        chatPanel.hidden = forceOpen === undefined ? !chatPanel.hidden : !forceOpen;
        if (!chatPanel.hidden) {
          chatUnread = 0;
          updateChatUnreadBadge();
          if (!chatSocket) {
            connectChatSocket();
          }
        }
      }

