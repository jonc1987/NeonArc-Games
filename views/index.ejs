          card.appendChild(title);
          card.appendChild(meta);
          const actions = document.createElement('div');
          actions.className = 'friend-request-actions';
          if (type === 'incoming') {
            const accept = document.createElement('button');
            accept.type = 'button';
            accept.className = 'button primary';
            accept.textContent = 'Accept';
            accept.addEventListener('click', () =>
              respondToFriendRequest(request.id, 'accept', request.requesterUsername),
            );
            const decline = document.createElement('button');
            decline.type = 'button';
            decline.className = 'button ghost-button';
            decline.textContent = 'Decline';
            decline.addEventListener('click', () =>
              respondToFriendRequest(request.id, 'decline', request.requesterUsername),
            );
