      .perception-card.analyzed .perception-analysis-result {
        color: #6ef3ff;
      }

      .perception-card.revealed.truth .perception-analysis-result {
        color: #6effc7;
      }

      .perception-card.revealed.illusion .perception-analysis-result {
        color: #ff7abf;
      }

      .perception-analyze-btn {
        margin-top: 6px;
