      async function purchaseShopItem(item) {
        if (!item || !requireActiveSession()) return;

        const price = Number(item.price);
        if (!Number.isFinite(price) || price <= 0) {
          setAccountStatus('This item cannot be purchased right now.', true);
          return;
        }

        const availableCash = Number(accountData?.cashBalance ?? 0);
        if (availableCash < price) {
          setAccountStatus('Not enough cash credits to buy this item.', true);
          return;
        }

        try {
          setAccountStatus(`Purchasing ${item.name}...`);
          const response = await fetch('/api/shop/purchase', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemId: item.id }),
          });
          const payload = await response.json().catch(() => ({}));

          if (response.status === 401) {
            clearAccountData('Session expired. Please log in again.', true);
            setAuthStatus('Session expired. Please log in again.', true);
            return;
          }

          if (!response.ok) {
            setAccountStatus(payload.error || 'Unable to complete purchase.', true);
            return;
          }

          const updatedUser = payload.user;
          if (updatedUser) {
            applyAccountData(updatedUser);
            renderShopItems(shopItems);
            setAccountStatus(`Purchased ${item.name}!`);
            recordQuestEvent('shop_purchase');
