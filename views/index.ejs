      .perception-visible .color,
      .perception-reality .color {
        font-size: 14px;
        letter-spacing: 0.3em;
      }

      .perception-reality {
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      .perception-card.revealed .perception-reality {
        opacity: 1;
        transform: translateY(0);
      }

      .perception-analysis-result {
        font-size: 13px;
        letter-spacing: 0.2em;
