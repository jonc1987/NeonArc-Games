        padding: 28px 24px;
        border-radius: 18px;
        border: 1px dashed rgba(110, 255, 236, 0.28);
        background: rgba(2, 12, 22, 0.6);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.45);
      }

      .binary-target {
        position: relative;
        z-index: 2;
        font-family: 'Orbitron', sans-serif;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        font-size: clamp(12px, 1.8vw, 14px);
        color: rgba(255, 255, 255, 0.65);
        text-align: center;
      }

      .card-controls h2 {
        letter-spacing: 0.2em;
      }

      .stack-stage {
        display: flex;
        flex-direction: column;
        gap: clamp(18px, 3vw, 28px);
        padding: clamp(32px, 5vw, 60px);
        aspect-ratio: auto;
        min-height: clamp(380px, 62vh, 560px);
        overflow: visible;
      }

      .stack-grid {
        display: flex;
        align-items: stretch;
        gap: clamp(20px, 4vw, 32px);
        width: 100%;
      }

      .stack-column {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
      }

      .stack-opponent-panel {
        flex: 0.9;
        border-radius: 18px;
        border: 1px solid rgba(110, 243, 255, 0.18);
        background: linear-gradient(145deg, rgba(4, 12, 22, 0.9), rgba(10, 18, 32, 0.85));
        padding: 18px;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45);
        display: grid;
        gap: 12px;
        align-content: start;
      }

      .stack-opponent-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
      }

      .stack-opponent-status {
        font-weight: 600;
        color: #6ef3ff;
      }

      .stack-opponent-body {
        display: grid;
        gap: 10px;
      }

      .opponent-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(44px, 1fr));
        gap: 8px;
      }

      .opponent-card {
        border-radius: 10px;
        border: 1px solid rgba(110, 243, 255, 0.25);
        background: rgba(255, 255, 255, 0.03);
        text-align: center;
        padding: 10px 6px;
        font-weight: 700;
        color: #eaf9ff;
        box-shadow: inset 0 0 16px rgba(110, 243, 255, 0.12);
      }

      .opponent-score {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.75);
      }

      .opponent-score strong {
        display: block;
        color: #6ef3ff;
      }

      .stack-area {
        position: relative;
        width: clamp(160px, 30vw, 240px);
        height: clamp(240px, 42vw, 380px);
        border-radius: 28px;
        border: 1px solid rgba(110, 255, 236, 0.22);
        background: radial-gradient(circle at 50% 15%, rgba(18, 30, 40, 0.8), rgba(5, 8, 16, 0.95));
        box-shadow: inset 0 0 40px rgba(0, 255, 235, 0.12);
        overflow: hidden;
        transform-origin: center bottom;
        animation: stackSway 5s ease-in-out infinite;
        --stack-wobble: 0;
      }

      .stack-stage.live .stack-area {
        --stack-wobble: 2;
      }

      .stack-stage.collapsed .stack-area {
        animation: stackShake 0.3s linear infinite;
      }

      @keyframes stackSway {
        0% {
          transform: rotate(calc(var(--stack-wobble, 0) * -1deg));
        }
        50% {
          transform: rotate(calc(var(--stack-wobble, 0) * 1deg));
        }
        100% {
          transform: rotate(calc(var(--stack-wobble, 0) * -1deg));
        }
      }

      @keyframes stackShake {
        0% {
          transform: translate(1px, 0);
        }
        25% {
          transform: translate(-1px, -1px);
        }
        50% {
          transform: translate(1px, 1px);
        }
        75% {
          transform: translate(-1px, 1px);
        }
        100% {
          transform: translate(1px, -1px);
        }
      }

      .stack-tower {
        position: absolute;
        bottom: 58px;
        left: 50%;
        transform: translateX(-50%);
        width: 70%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        justify-content: flex-end;
      }

      .stack-base {
        position: absolute;
        bottom: 22px;
        left: 50%;
        transform: translateX(-50%);
        width: 140%;
        height: 26px;
        background: linear-gradient(90deg, rgba(110, 255, 236, 0), rgba(110, 255, 236, 0.45), rgba(110, 255, 236, 0));
        border-radius: 40px;
        box-shadow: 0 0 30px rgba(110, 255, 236, 0.4);
      }

      .stack-card {
        width: 100%;
        min-height: 40px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: linear-gradient(135deg, rgba(0, 255, 200, 0.7), rgba(0, 110, 255, 0.65));
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35), 0 0 25px rgba(0, 255, 204, 0.35);
        text-align: center;
        font-family: 'Orbitron', sans-serif;
        font-size: 22px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #011;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: translateY(16px) scale(0.95);
        transition: opacity 0.25s ease, transform 0.25s ease;
      }

      .stack-card.landed {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .stack-card[data-value='10'],
      .stack-card[data-value='11'] {
        background: linear-gradient(135deg, rgba(255, 120, 210, 0.85), rgba(255, 220, 120, 0.85));
      }

      .stack-card[data-value='2'],
      .stack-card[data-value='3'] {
        background: linear-gradient(135deg, rgba(110, 255, 236, 0.8), rgba(0, 180, 255, 0.75));
      }

      .stack-bust {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(24px, 4vw, 40px);
        letter-spacing: 0.3em;
        color: rgba(255, 90, 90, 0.85);
        text-shadow: 0 0 18px rgba(255, 90, 90, 0.7);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      .stack-stage.collapsed .stack-bust {
        opacity: 1;
      }

      .stack-hud {
        width: 100%;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.65);
      }

      .stack-hud strong {
        display: block;
        font-size: clamp(18px, 2.2vw, 24px);
        color: #6ef3ff;
      }

      .instability-panel {
        flex: 0 0 180px;
        border-radius: 22px;
        border: 1px solid rgba(110, 255, 236, 0.18);
        padding: 18px;
        background: rgba(2, 12, 22, 0.6);
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.65);
      }

      .instability-meter {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .meter-track {
        flex: 1;
        height: 180px;
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(0, 255, 204, 0.2), rgba(255, 196, 0, 0.2), rgba(255, 85, 85, 0.25));
        border: 1px solid rgba(255, 255, 255, 0.08);
        position: relative;
        overflow: hidden;
      }

      .meter-fill {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 0%;
        background: linear-gradient(180deg, #00ffc8, #ffd257, #ff5c5c);
        box-shadow: 0 0 22px rgba(255, 140, 0, 0.35);
        transition: height 0.25s ease;
      }

      .instability-value {
        font-family: 'Orbitron', sans-serif;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-size: 16px;
        color: #6ef3ff;
      }

      .stack-status {
        text-align: center;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
        font-size: 13px;
      }

      @media (max-width: 768px) {
        .app-shell {
          gap: 16px;
        }

        .hero-section {
          flex-direction: column;
          align-items: flex-start;
        }

        .balance,
        .title {
          width: 100%;
          text-align: center;
        }

        .category-grid,
        .game-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .category-panel,
        .game-tile {
          padding: 18px;
          border-radius: 22px;
        }
      }

      @media (max-width: 960px) {
        .main-layout {
          grid-template-columns: 1fr;
        }

        .device-shell {
          margin: 0 auto;
        }
      }

      @media (max-width: 600px) {
        .hero-section {
          flex-direction: column;
          align-items: flex-start;
        }

        .mode-switcher {
          width: 100%;
          justify-content: center;
        }

        .button-row {
          flex-direction: column;
        }

        button {
          width: 100%;
        }

        .stack-grid {
          flex-direction: column;
        }

        .instability-panel {
          width: 100%;
        }

        .instability-meter {
          justify-content: center;
        }

        .meter-track {
          height: 140px;
        }
      }
    </style>
  </head>
