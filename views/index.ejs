            const cancel = document.createElement('button');
            cancel.type = 'button';
            cancel.className = 'button ghost-button';
            cancel.textContent = 'Cancel';
            cancel.addEventListener('click', () =>
              respondToFriendRequest(request.id, 'decline', request.recipientUsername),
            );
