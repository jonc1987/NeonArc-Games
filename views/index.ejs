      async function fetchSessionAccount() {
        try {
          const response = await fetch('/api/account');
          if (!response.ok) return null;
          const payload = await response.json();
          return payload?.user || null;
        } catch (error) {
          console.error('Failed to load account', error);
          return null;
        }
      }

      function applyAccountData(account) {
        if (!account) return;
        const cash = normalizeCurrency(account.cashBalance ?? account.balance ?? 0);
        const credits = normalizeCurrency(account.creditBalance ?? 0);
        setWallet({ cash, credits });
        accountData = {
          ...account,
          cashBalance: cash,
          creditBalance: credits,
          balance: getTotalBalance(),
        };
        renderAccountDetails();
        updateBalance(false);
        applyViewPreferences(accountData);
        renderShopItems(shopItems);
        renderCreditPacks(creditPackCache);
        updateAuthVisibility();
        if (openAccountHubBtn) {
          openAccountHubBtn.disabled = false;
          openAccountHubBtn.textContent = 'Account Hub';
        }
        connectChatSocket();
      }

      function clearAccountData(message = 'Login or register to access the account hub.', isError = false) {
        accountData = null;
        setWallet({ cash: 0, credits: 0 });
        renderAccountDetails();
        updateBalance(false);
        applyViewPreferences({ viewMode: 'standard', dashboardNote: '' });
        updateAuthVisibility();
        renderCreditPacks(creditPackCache);
        if (openAccountHubBtn) {
          openAccountHubBtn.disabled = false;
          openAccountHubBtn.textContent = 'Account Hub';
        }
        setAccountStatus(message, isError);
        shutdownChatSocket();
      }

      async function initializeAccount() {
        setAccountStatus('Checking session...');
        const existing = await fetchSessionAccount();
        if (existing) {
          applyAccountData(existing);
          setAccountStatus('Session active. Welcome back.');
          setAuthStatus(`Logged in as ${existing.username}.`);
          updateAuthVisibility();
          return;
        }
        clearAccountData();
        setAuthStatus('Login or register to begin.');
        updateAuthVisibility();
      }

      function requireActiveSession() {
        if (!accountData) {
          setAccountStatus('Please log in to use account actions.', true);
          toggleAuthForm('login');
          return false;
        }
        return true;
      }

      async function submitAuthForm(event, mode) {
        event.preventDefault();
        const form = event.target;
        const formData = new FormData(form);
        const username = formData.get('username')?.toString().trim();
        const password = formData.get('password')?.toString().trim();
        if (!username || !password) {
          setAuthStatus('Username and password are required.', true);
          return;
        }

        setAuthStatus(mode === 'login' ? 'Logging in...' : 'Creating your account...');
        try {
          const response = await fetch(`/api/${mode}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });

          if (!response.ok) {
            const errorPayload = await response.json().catch(() => ({}));
            setAuthStatus(errorPayload.error || 'Unable to process request.', true);
            return;
          }

          const payload = await response.json();
          if (payload?.user) {
            applyAccountData(payload.user);
          setAuthStatus(
            mode === 'login'
              ? `Welcome back, ${payload.user.username}.`
              : 'Account created with a 100 credit starting balance.',
          );
            setAccountStatus('Account ready.');
            closeAuthForms();
          }
        } catch (error) {
          console.error('Authentication failed', error);
          setAuthStatus('Unable to reach the server.', true);
        }
      }

      async function handleLogout() {
        try {
          await fetch('/api/logout', { method: 'POST' });
        } catch (error) {
          console.error('Logout failed', error);
        }
        clearAccountData('Logged out. Login again to access your account.');
        setAuthStatus('You have been logged out.');
        closeAuthForms();
      }

      async function updateAccountBalance(delta) {
        if (!requireActiveSession()) return null;
        try {
          setAccountStatus('Updating balance...');
          const response = await fetch('/api/update-balance', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cashDelta: delta }),
          });
          if (response.status === 401) {
            clearAccountData('Session expired. Please log in again.', true);
            setAuthStatus('Session expired. Please log in again.', true);
            return null;
          }
          if (!response.ok) {
            setAccountStatus('Balance update failed.', true);
            return null;
          }
          const payload = await response.json();
          if (payload?.user) {
            applyAccountData(payload.user);
            setAccountStatus('Balance synced.');
            return payload.user;
          }
          setAccountStatus('Balance update failed.', true);
          return null;
        } catch (error) {
          console.error('Failed to update balance', error);
          setAccountStatus('Could not reach the account service.', true);
          return null;
        }
      }
        async function requestCashOut() {
          if (!requireActiveSession()) return;
          const withdrawable = normalizeCurrency(accountData?.cashBalance ?? cashBalance ?? 0);
          setAccountStatus('Cash outs are open. Enter the amount you want to reserve.');

          const input = prompt('How much would you like to cash out?');
          if (input === null) return;

          const parsed = Number(input);
          const amount = Math.floor(parsed * 100) / 100;

          if (!Number.isFinite(amount) || amount <= 0) {
            alert('Enter a valid cash-out amount.');
            return;
          }

          if (amount > withdrawable) {
            alert('Requested amount exceeds your cash-out eligible winnings.');
            return;
          }

          try {
            setAccountStatus('Submitting cash-out request...');
            const response = await fetch('/api/cashout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: accountData?.id, amount }),
            });

            const payload = await response.json().catch(() => ({}));

            if (response.status === 401) {
              clearAccountData('Session expired. Please log in again.', true);
              setAuthStatus('Session expired. Please log in again.', true);
              return;
            }

            if (!response.ok) {
              setAccountStatus(payload.error || 'Unable to submit cash-out request.', true);
              alert(payload.error || 'Unable to submit cash-out request.');
              return;
            }

            if (payload?.user) {
              applyAccountData(payload.user);
            } else {
              cashBalance = normalizeCurrency(cashBalance - amount);
              balance = getTotalBalance();
              if (accountData) {
                accountData.cashBalance = cashBalance;
                accountData.balance = balance;
              }
              updateBalance(false);
            }

            alert('Cash-out request submitted. Please allow manual review.');
            setAccountStatus('Cash-out request recorded. Jump back into a run while we review it.');
          } catch (error) {
            console.error('Cash-out request failed', error);
            setAccountStatus('Could not submit cash-out request.', true);
            alert('Could not submit cash-out request.');
          }
        }

      async function refreshAccountFromServer() {
        if (!requireActiveSession()) return;
        const latest = await fetchSessionAccount();
        if (latest) {
          applyAccountData(latest);
          setAccountStatus('Account refreshed.');
        } else {
          setAccountStatus('Unable to refresh account.', true);
        }
      }

