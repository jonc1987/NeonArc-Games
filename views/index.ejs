      function getTierWinModifier() {
        return 1;
      }

      function getTierVolatilityScale() {
        return 1;
      }

      function tieredWinAllowed(baseChance = 0.35) {
        const modifier = getTierWinModifier();
        const allowedChance = Math.max(0, Math.min(1, baseChance * modifier));
        return Math.random() < allowedChance;
      }

      function gateTieredPayout({ baseChance = 0.35, onFailure }) {
        return true;
      }

      function applyTierVolatility(value) {
        const scale = getTierVolatilityScale();
        return Math.max(1, Number((value * scale).toFixed(2)));
