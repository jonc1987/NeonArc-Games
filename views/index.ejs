        { value: 'fuse', label: 'Fuse' },
        { value: 'perception', label: 'Perception' },
      ];
      const FRIENDLY_GAME_ALIASES = new Map([
        ['stackjack', 'stack'],
        ['stack-jack', 'stack'],
        ['stack_jack', 'stack'],
      ]);
      const FRIENDLY_GAME_CANONICAL = new Map(
        FRIENDLY_GAMES.map((entry) => [entry.value.toLowerCase(), entry.value]),
      );

      function resolveFriendlyGame(value) {
        if (!value) return null;
        const normalized = value?.toString().trim();
        if (!normalized) return null;
        const key = normalized.toLowerCase();
        if (FRIENDLY_GAME_CANONICAL.has(key)) {
          return FRIENDLY_GAME_CANONICAL.get(key);
        }
        if (FRIENDLY_GAME_ALIASES.has(key)) {
          return FRIENDLY_GAME_ALIASES.get(key);
        }
        return null;
      }

      function scheduleFriendlyGameLaunch(game) {
        if (!game || typeof enterGame !== 'function') return;
        const runner = () => enterGame(game);
        if (window.requestAnimationFrame) {
          window.requestAnimationFrame(runner);
        } else {
          setTimeout(runner, 0);
        }
      }
      const initialFriendlyParams = {
        friend: null,
        game: null,
        session: null,
      };
      const urlParams = new URLSearchParams(window.location.search);
      initialFriendlyParams.friend = urlParams.get('friend')?.trim() || null;
      initialFriendlyParams.game = resolveFriendlyGame(urlParams.get('game'));
      initialFriendlyParams.session = urlParams.get('session')?.trim() || null;

      function normalizeCurrency(value, { clamp = true } = {}) {
        const numeric = Number(value);
        if (!Number.isFinite(numeric)) return 0;
        const rounded = Math.round(numeric * 100) / 100;
        return clamp ? Math.max(0, rounded) : rounded;
      }

      function getTotalBalance() {
        return normalizeCurrency(cashBalance + creditBalance);
      }

      function setWallet({ cash = 0, credits = 0 } = {}) {
        cashBalance = normalizeCurrency(cash);
        creditBalance = normalizeCurrency(credits);
        balance = getTotalBalance();
      }

      function spendFromWallet(amount) {
        const debit = normalizeCurrency(amount);
        if (debit <= 0) return false;
        const total = getTotalBalance();
        if (debit > total) return false;
        const cashUsed = Math.min(cashBalance, debit);
        cashBalance = normalizeCurrency(cashBalance - cashUsed);
        const remaining = normalizeCurrency(debit - cashUsed);
        if (remaining > 0) {
          creditBalance = normalizeCurrency(creditBalance - remaining);
        }
        balance = getTotalBalance();
        updateBalance();
        return true;
      }

      function addCashWinnings(amount) {
        const gain = normalizeCurrency(amount);
        if (gain <= 0) return 0;
        cashBalance = normalizeCurrency(cashBalance + gain);
        balance = getTotalBalance();
        updateBalance();
        recordQuestEvent('win', { amount: gain });
        return gain;
      }

      function addCreditDeposit(amount) {
        const gain = normalizeCurrency(amount);
        if (gain <= 0) return 0;
        creditBalance = normalizeCurrency(creditBalance + gain);
        balance = getTotalBalance();
        updateBalance();
        return gain;
      }

