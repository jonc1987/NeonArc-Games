<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="NeonArc Casino" />
    <meta name="theme-color" content="#050814" />
    <meta name="format-detection" content="telephone=no" />
    <title>NeonArc Management</title>
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        padding: 24px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #0b1220;
        color: #e8edf4;
      }
      h1 {
        margin-bottom: 6px;
      }
      .page-subtitle {
        margin-top: 0;
        color: #9fb1ca;
      }
      .grid {
        display: grid;
        gap: 20px;
      }
      .card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 16px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
      }
      .card h2 {
        margin-top: 0;
        margin-bottom: 12px;
        font-size: 18px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th,
      td {
        text-align: left;
        padding: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }
      th {
        cursor: pointer;
        color: #c5d3ea;
        user-select: none;
      }
      tr:hover td {
        background: rgba(255, 255, 255, 0.03);
      }
      .controls {
        display: flex;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }
      .search-box {
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.03);
        color: #e8edf4;
        min-width: 220px;
      }
      .meta {
        color: #8fa2c1;
        font-size: 14px;
        margin-bottom: 8px;
      }
      .cashout-item {
        padding: 10px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        margin-bottom: 8px;
      }
      .cashout-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .pill {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(110, 243, 255, 0.16);
        color: #e8edf4;
        border: 1px solid rgba(110, 243, 255, 0.35);
        font-size: 12px;
      }
      .cashout-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 6px;
      }
      .cashout-empty {
        color: #8fa2c1;
      }
      .user-panel {
        margin-top: 14px;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .field-label {
        display: block;
        font-size: 14px;
        color: #9fb1ca;
        margin-bottom: 4px;
      }
      .input,
      .textarea,
      .select {
        width: 100%;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.05);
        color: #e8edf4;
      }
      .inline-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }
      .button {
        padding: 10px 14px;
        border-radius: 10px;
        background: linear-gradient(120deg, rgba(110, 243, 255, 0.18), rgba(255, 110, 230, 0.14));
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #e8edf4;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .button:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
      }
      .muted {
        color: #8fa2c1;
        font-size: 14px;
      }
      .row-selected td {
        background: rgba(110, 243, 255, 0.08);
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        color: #0b1220;
        background: linear-gradient(120deg, rgba(110, 243, 255, 0.9), rgba(255, 110, 230, 0.8));
      }
      .code-card {
        display: grid;
        gap: 10px;
      }
      .code-block {
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 12px;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        color: #c5d3ea;
        overflow-x: auto;
      }
      .copy-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }
      .user-panel h3 {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Management Dashboard</h1>
      <p class="page-subtitle">Secure view for administrators only.</p>
    </header>

    <section class="grid">
      <div class="card">
        <div class="controls">
          <input class="search-box" type="search" id="userSearch" placeholder="Search by username or ID" />
          <div class="meta" id="userCount"></div>
        </div>
        <div class="table-wrapper">
          <table aria-label="User overview">
            <thead>
              <tr>
                <th data-sort="username">Username ▾</th>
                <th data-sort="email">Email</th>
                <th data-sort="id">User ID</th>
                <th data-sort="balance">Balance</th>
                <th data-sort="joinedAt">Join Date</th>
                <th data-sort="lastActivity">Last Activity</th>
              </tr>
            </thead>
            <tbody id="userTableBody"></tbody>
          </table>
        </div>

        <div class="user-panel" id="userControls">
          <div class="meta" id="selectedUserLabel">Select a user to manage balance and visibility.</div>
          <div class="inline-form">
            <div style="flex: 1 1 180px; min-width: 160px;">
              <label class="field-label" for="creditAmount">Add balance</label>
              <input class="input" type="number" step="0.01" min="0" id="creditAmount" placeholder="$0.00" />
            </div>
            <div style="align-self: flex-end;">
              <button class="button" type="button" id="creditBtn" disabled>Apply Credit</button>
            </div>
          </div>
          <div class="inline-form">
            <div style="flex: 1 1 180px; min-width: 160px;">
              <label class="field-label" for="debitAmount">Remove balance</label>
              <input class="input" type="number" step="0.01" min="0" id="debitAmount" placeholder="$0.00" />
            </div>
            <div style="align-self: flex-end;">
              <button class="button" type="button" id="debitBtn" disabled>Apply Debit</button>
            </div>
          </div>
          <div>
            <label class="field-label" for="viewModeSelect">What this user sees</label>
            <select class="select" id="viewModeSelect" disabled>
              <option value="standard">Standard experience</option>
              <option value="vip">VIP focus</option>
              <option value="limited">Limited/preview view</option>
            </select>
          </div>
          <div>
            <label class="field-label" for="dashboardNote">User-facing note</label>
            <textarea
              class="textarea"
              rows="3"
              id="dashboardNote"
              maxlength="240"
              placeholder="Optional dashboard note the user will see in their profile."
              disabled
            ></textarea>
          </div>
          <div class="inline-form" style="justify-content: space-between; align-items: center;">
            <button class="button" type="button" id="saveDisplayBtn" disabled>Save View Preferences</button>
            <span class="badge" id="viewModeBadge">Awaiting selection</span>
          </div>
          <div class="inline-form" style="justify-content: space-between; align-items: center;">
            <button class="button" type="button" id="resetBalanceBtn" disabled>Reset Balance</button>
            <button
              class="button"
              type="button"
              id="deleteAccountBtn"
              disabled
              style="background: linear-gradient(120deg, rgba(255, 155, 179, 0.18), rgba(255, 70, 70, 0.14));"
            >
              Delete Account
            </button>
          </div>
          <p class="muted" id="controlStatus">Choose a user from the table to enable controls.</p>
        </div>
      </div>

      <div class="card">
        <h2>Pending Cash Outs</h2>
        <div class="meta" id="cashoutMeta"></div>
        <div id="cashoutList"></div>
        <h2 style="margin-top: 16px;">Completed Payouts</h2>
        <div id="cashoutCompleted"></div>
      </div>

      <div class="card code-card">
        <div class="copy-row">
          <h2 style="margin: 0;">Recovery SQL</h2>
          <button class="button" type="button" id="copyRecovery">Copy recovery script</button>
        </div>
        <p class="muted" style="margin: 0;">Run this script on a fresh PostgreSQL database to recreate the schema and repopulate users, cashouts, and campaigns.</p>
        <pre class="code-block" id="recoverySql"><%= recoverySql %></pre>
        <div class="status" id="copyStatus"></div>
      </div>

      <div class="card">
        <h2>Email Campaigns</h2>
        <div class="meta" id="campaignMeta">Loading campaigns...</div>
        
        <div style="margin-bottom: 20px;">
          <h3 style="margin-top: 0;">Create New Campaign</h3>
          <div class="user-panel" style="margin-top: 0; padding-bottom: 0;">
            <div style="display: grid; gap: 12px;">
              <div>
                <label class="field-label" for="campaignName">Campaign Name</label>
                <input class="input" type="text" id="campaignName" placeholder="e.g., Spring Promo 2025" />
              </div>
              <div>
                <label class="field-label" for="campaignSubject">Email Subject</label>
                <input class="input" type="text" id="campaignSubject" placeholder="e.g., Exclusive Offer Just for You" />
              </div>
              <div>
                <label class="field-label" for="campaignHtml">HTML Email Content</label>
                <textarea class="textarea" id="campaignHtml" rows="8" placeholder="Paste your HTML email template here. You can use inline CSS."></textarea>
                <p class="muted" style="margin-top: 6px;">Tip: Use inline CSS styles for best email client compatibility.</p>
              </div>
              <button class="button" type="button" id="createCampaignBtn">Create Campaign</button>
              <div id="createStatus" style="margin-top: 6px;"></div>
            </div>
          </div>
        </div>

        <div>
          <h3 style="margin-top: 0; margin-bottom: 12px;">Existing Campaigns</h3>
          <div id="campaignsList"></div>
        </div>
      </div>

      <div class="card">
        <h2>Send Individual Email</h2>
        <div class="user-panel" style="margin-top: 0;">
          <div style="display: grid; gap: 12px;">
            <div>
              <label class="field-label" for="individualEmail">User Email</label>
              <input class="input" type="email" id="individualEmail" placeholder="user@example.com" />
            </div>
            <div>
              <label class="field-label" for="individualSubject">Email Subject</label>
              <input class="input" type="text" id="individualSubject" placeholder="Message subject" />
            </div>
            <div>
              <label class="field-label" for="individualHtml">HTML Content</label>
              <textarea class="textarea" id="individualHtml" rows="8" placeholder="Paste your HTML email template here."></textarea>
            </div>
            <button class="button" type="button" id="sendIndividualBtn">Send Email</button>
            <div id="individualStatus" style="margin-top: 6px;"></div>
          </div>
        </div>
      </div>
    </section>

    <script>
      let users = <%- JSON.stringify(users || []) %>;
      let cashouts = <%- JSON.stringify(cashouts || []) %>;

      const userTableBody = document.getElementById('userTableBody');
      const searchInput = document.getElementById('userSearch');
      const userCount = document.getElementById('userCount');
      const cashoutList = document.getElementById('cashoutList');
      const cashoutCompletedList = document.getElementById('cashoutCompleted');
      const cashoutMeta = document.getElementById('cashoutMeta');
      const creditInput = document.getElementById('creditAmount');
      const creditBtn = document.getElementById('creditBtn');
      const debitInput = document.getElementById('debitAmount');
      const debitBtn = document.getElementById('debitBtn');
      const viewModeSelect = document.getElementById('viewModeSelect');
      const dashboardNoteInput = document.getElementById('dashboardNote');
      const saveDisplayBtn = document.getElementById('saveDisplayBtn');
      const selectedUserLabel = document.getElementById('selectedUserLabel');
      const controlStatus = document.getElementById('controlStatus');
      const viewModeBadge = document.getElementById('viewModeBadge');
      const recoverySql = document.getElementById('recoverySql');
      const copyRecoveryBtn = document.getElementById('copyRecovery');
      const copyStatus = document.getElementById('copyStatus');
      const resetBalanceBtn = document.getElementById('resetBalanceBtn');
      const deleteAccountBtn = document.getElementById('deleteAccountBtn');

      const adminKey = new URLSearchParams(window.location.search).get('key') || '';

      let currentSort = { key: 'username', direction: 'asc' };
      let selectedUserId = null;

      function formatDate(value) {
        if (!value) return '—';
        const parsed = new Date(value);
        if (Number.isNaN(parsed.getTime())) return '—';
        return parsed.toLocaleString();
      }

      function formatCurrency(value) {
        return `$${Number(value || 0).toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        })}`;
      }

      function renderUsers(list) {
        if (!userTableBody) return;
        userTableBody.innerHTML = '';
        list.forEach((user) => {
          const row = document.createElement('tr');
          row.dataset.userId = user.id;
          if (user.id === selectedUserId) {
            row.classList.add('row-selected');
          }
          row.innerHTML = `
            <td>${user.username || '—'}</td>
            <td>${user.email || '—'}</td>
            <td>${user.id || '—'}</td>
            <td>${formatCurrency(user.balance)}</td>
            <td>${formatDate(user.joinedAt)}</td>
            <td>${formatDate(user.lastActivity)}</td>
          `;
          row.addEventListener('click', () => selectUser(user));
          userTableBody.appendChild(row);
        });
        if (userCount) {
          userCount.textContent = `${list.length} user${list.length === 1 ? '' : 's'} shown`;
        }
      }

      function sortUsers(list, key, direction = 'asc') {
        const sorted = [...list].sort((a, b) => {
          const first = a?.[key] || '';
          const second = b?.[key] || '';
          if (key === 'balance') {
            return direction === 'asc' ? first - second : second - first;
          }
          if (key === 'joinedAt' || key === 'lastActivity') {
            const firstTime = new Date(first).getTime();
            const secondTime = new Date(second).getTime();
            return direction === 'asc' ? firstTime - secondTime : secondTime - firstTime;
          }
          const firstVal = first.toString().toLowerCase();
          const secondVal = second.toString().toLowerCase();
          if (firstVal < secondVal) return direction === 'asc' ? -1 : 1;
          if (firstVal > secondVal) return direction === 'asc' ? 1 : -1;
          return 0;
        });
        return sorted;
      }

      function applyFilters() {
        const query = searchInput?.value?.trim().toLowerCase();
        let list = [...users];

        if (query) {
          list = list.filter((user) => {
            return (
              user.username?.toLowerCase().includes(query) ||
              user.email?.toLowerCase().includes(query) ||
              user.id?.toLowerCase().includes(query)
            );
          });
        }

        const sorted = sortUsers(list, currentSort.key, currentSort.direction);
        renderUsers(sorted);
        syncSelectionControls();
      }

      function renderCashouts() {
        if (!cashoutList || !cashoutCompletedList) return;
        cashoutList.innerHTML = '';
        cashoutCompletedList.innerHTML = '';

        const pending = cashouts.filter((entry) => (entry.status || 'pending') !== 'completed' && entry.remaining > 0);
        const completed = cashouts.filter((entry) => (entry.status || 'pending') === 'completed' || entry.remaining <= 0);

        if (cashoutMeta) {
          cashoutMeta.textContent = `${pending.length} pending · ${completed.length} completed`;
        }

        if (!pending.length) {
          const empty = document.createElement('p');
          empty.className = 'cashout-empty';
          empty.textContent = 'No pending cash outs.';
          cashoutList.appendChild(empty);
        } else {
          pending.forEach((entry) => {
            const item = document.createElement('div');
            item.className = 'cashout-item';
            item.innerHTML = `
              <div class="cashout-row">
                <div><strong>${entry.username}</strong> requested ${formatCurrency(entry.amount)}</div>
                <span class="pill">${formatCurrency(entry.remaining)} owed</span>
              </div>
              <div class="muted">Paid ${formatCurrency(entry.paidAmount)} · Requested ${formatDate(entry.requestedAt)}</div>
              <div class="cashout-actions">
                <input class="input" type="number" step="0.01" min="0" placeholder="Amount paid"
                  data-cashout="${entry.id}" />
                <button class="button record-payment" type="button" data-cashout="${entry.id}">Record payment</button>
              </div>
            `;

            const input = item.querySelector('input[data-cashout]');
            const button = item.querySelector('button[data-cashout]');
            if (button) {
              button.addEventListener('click', () => recordPayment(entry.id, input));
            }
            cashoutList.appendChild(item);
          });
        }

        if (!completed.length) {
          const empty = document.createElement('p');
          empty.className = 'cashout-empty';
          empty.textContent = 'No completed payouts yet.';
          cashoutCompletedList.appendChild(empty);
        } else {
          completed.forEach((entry) => {
            const item = document.createElement('div');
            item.className = 'cashout-item';
            item.innerHTML = `
              <div class="cashout-row">
                <div><strong>${entry.username}</strong> paid in full.</div>
                <span class="pill">${formatCurrency(entry.amount)} completed</span>
              </div>
              <div class="muted">Last updated ${formatDate(entry.lastUpdated || entry.requestedAt)}</div>
            `;
            cashoutCompletedList.appendChild(item);
          });
        }
      }

      function setControlStatus(message, isError = false) {
        if (!controlStatus) return;
        controlStatus.textContent = message;
        controlStatus.style.color = isError ? '#ff9bb3' : '#8fa2c1';
      }

      async function recordPayment(cashoutId, inputEl) {
        if (!adminKey) {
          setControlStatus('Admin key missing from request.', true);
          return;
        }
        const amount = Number(inputEl?.value);
        if (!Number.isFinite(amount) || amount <= 0) {
          setControlStatus('Enter the amount paid to record progress.', true);
          return;
        }

        try {
          setControlStatus('Recording payout...');
          const response = await fetch(`/api/admin/cashouts/${cashoutId}/pay`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({ amount }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setControlStatus(payload.error || 'Unable to record payout.', true);
            return;
          }
          const updated = payload.cashout;
          if (updated) {
            cashouts = cashouts.map((entry) => (entry.id === updated.id ? updated : entry));
            setControlStatus('Payout progress updated.');
            renderCashouts();
            if (inputEl) inputEl.value = '';
          }
        } catch (error) {
          console.error('Failed to record payout', error);
          setControlStatus('Unable to record payout right now.', true);
        }
      }

      function syncSelectionControls() {
        const selectedUser = users.find((user) => user.id === selectedUserId) || null;
        const hasSelection = Boolean(selectedUser);
        [creditBtn, debitBtn, viewModeSelect, dashboardNoteInput, saveDisplayBtn, resetBalanceBtn, deleteAccountBtn].forEach((el) => {
          if (el) el.disabled = !hasSelection || !adminKey;
        });
        if (creditInput) creditInput.disabled = !hasSelection;
        if (debitInput) debitInput.disabled = !hasSelection;

        if (!hasSelection) {
          if (selectedUserLabel) selectedUserLabel.textContent = 'Select a user to manage balance and visibility.';
          if (viewModeBadge) viewModeBadge.textContent = adminKey ? 'Awaiting selection' : 'Admin key missing';
          setControlStatus(adminKey ? 'Choose a user from the table to enable controls.' : 'Admin key missing from request.', !adminKey);
          return;
        }

        if (selectedUserLabel)
          selectedUserLabel.textContent = `Editing ${selectedUser.username} (${selectedUser.id})`;
        if (viewModeSelect) viewModeSelect.value = selectedUser.viewMode || 'standard';
        if (dashboardNoteInput)
          dashboardNoteInput.value = selectedUser.dashboardNote || '';
        if (viewModeBadge)
          viewModeBadge.textContent = `${selectedUser.viewMode || 'standard'} view`.replace(/\b\w/g, (m) => m.toUpperCase());
        setControlStatus('Adjust balance, reset the wallet, or change what this user sees.');
      }

      function selectUser(user) {
        selectedUserId = user?.id || null;
        syncSelectionControls();
        applyFilters();
      }

      async function copyRecoverySql() {
        if (!recoverySql) return;
        try {
          await navigator.clipboard.writeText(recoverySql.textContent.trim());
          if (copyStatus) {
            copyStatus.textContent = 'SQL copied to clipboard.';
            copyStatus.style.color = '#9cc9e7';
          }
        } catch (error) {
          console.error('Copy failed', error);
          if (copyStatus) {
            copyStatus.textContent = 'Unable to copy SQL to clipboard.';
            copyStatus.style.color = '#ff9bb3';
          }
        }
      }

      async function applyCredit() {
        const selectedUser = users.find((user) => user.id === selectedUserId);
        if (!selectedUser || !adminKey) return;
        const amount = Number(creditInput?.value);
        if (!Number.isFinite(amount) || amount <= 0) {
          setControlStatus('Enter a positive amount to credit.', true);
          return;
        }

        try {
          setControlStatus('Submitting credit...');
          const response = await fetch('/api/admin/credit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({ userId: selectedUser.id, amount }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setControlStatus(payload.error || 'Unable to credit balance.', true);
            return;
          }
          const updatedUser = payload.user;
          if (updatedUser) {
            users = users.map((user) => (user.id === updatedUser.id ? updatedUser : user));
            selectedUserId = updatedUser.id;
            setControlStatus('Balance updated.');
            applyFilters();
          }
        } catch (error) {
          console.error('Failed to credit user', error);
          setControlStatus('Unable to credit balance right now.', true);
        }
      }

      async function applyDebit() {
        const selectedUser = users.find((user) => user.id === selectedUserId);
        if (!selectedUser || !adminKey) return;
        const amount = Number(debitInput?.value);
        if (!Number.isFinite(amount) || amount <= 0) {
          setControlStatus('Enter a positive amount to debit.', true);
          return;
        }

        try {
          setControlStatus('Submitting debit...');
          const response = await fetch('/api/admin/debit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({ userId: selectedUser.id, amount }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setControlStatus(payload.error || 'Unable to debit balance.', true);
            return;
          }
          const updatedUser = payload.user;
          if (updatedUser) {
            users = users.map((user) => (user.id === updatedUser.id ? updatedUser : user));
            selectedUserId = updatedUser.id;
            setControlStatus('Balance reduced.');
            applyFilters();
          }
        } catch (error) {
          console.error('Failed to debit user', error);
          setControlStatus('Unable to debit balance right now.', true);
        }
      }

      async function resetSelectedUserBalance() {
        const selectedUser = users.find((user) => user.id === selectedUserId);
        if (!selectedUser || !adminKey) return;
        if (!confirm(`Reset ${selectedUser.username}'s balance to $0.00? This cannot be undone.`)) {
          return;
        }

        try {
          setControlStatus('Resetting user balance...');
          const response = await fetch(`/api/admin/users/${selectedUser.id}/reset-balance`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({}),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setControlStatus(payload.error || 'Unable to reset balance.', true);
            return;
          }
          const updatedUser = payload.user;
          if (updatedUser) {
            users = users.map((user) => (user.id === updatedUser.id ? updatedUser : user));
            selectedUserId = updatedUser.id;
            setControlStatus('Balance reset to zero.');
            applyFilters();
          }
        } catch (error) {
          console.error('Failed to reset balance', error);
          setControlStatus('Unable to reset balance right now.', true);
        }
      }

      async function deleteSelectedUserAccount() {
        const selectedUser = users.find((user) => user.id === selectedUserId);
        if (!selectedUser || !adminKey) return;
        if (!confirm(`Delete ${selectedUser.username}'s account permanently? This action cannot be undone.`)) {
          return;
        }

        try {
          setControlStatus('Deleting user account...');
          const response = await fetch(`/api/admin/users/${selectedUser.id}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setControlStatus(payload.error || 'Unable to delete account.', true);
            return;
          }
          users = users.filter((user) => user.id !== selectedUser.id);
          selectedUserId = null;
          setControlStatus('Account deleted.');
          applyFilters();
        } catch (error) {
          console.error('Failed to delete account', error);
          setControlStatus('Unable to delete account right now.', true);
        }
      }

      async function saveDisplayPreferences() {
        const selectedUser = users.find((user) => user.id === selectedUserId);
        if (!selectedUser || !adminKey) return;
        const viewMode = viewModeSelect?.value || 'standard';
        const dashboardNote = dashboardNoteInput?.value || '';

        try {
          setControlStatus('Saving view preferences...');
          const response = await fetch('/api/admin/display', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({ userId: selectedUser.id, viewMode, dashboardNote }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setControlStatus(payload.error || 'Unable to update view.', true);
            return;
          }
          const updatedUser = payload.user;
          if (updatedUser) {
            users = users.map((user) => (user.id === updatedUser.id ? updatedUser : user));
            selectedUserId = updatedUser.id;
            setControlStatus('User view updated.');
            applyFilters();
          }
        } catch (error) {
          console.error('Failed to update view preferences', error);
          setControlStatus('Unable to save view preferences right now.', true);
        }
      }

      document.querySelectorAll('th[data-sort]').forEach((header) => {
        header.addEventListener('click', () => {
          const key = header.dataset.sort;
          if (currentSort.key === key) {
            currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
          } else {
            currentSort = { key, direction: 'asc' };
          }
          document.querySelectorAll('th[data-sort]').forEach((h) => {
            h.textContent = h.textContent.replace(/[\s▾▴]+$/, '').trim();
            if (h.dataset.sort === currentSort.key) {
              h.textContent = `${h.textContent} ${currentSort.direction === 'asc' ? '▾' : '▴'}`;
            }
          });
          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
      }

      if (creditBtn) {
        creditBtn.addEventListener('click', applyCredit);
      }

      if (debitBtn) {
        debitBtn.addEventListener('click', applyDebit);
      }

      if (saveDisplayBtn) {
        saveDisplayBtn.addEventListener('click', saveDisplayPreferences);
      }
      if (resetBalanceBtn) {
        resetBalanceBtn.addEventListener('click', resetSelectedUserBalance);
      }
      if (deleteAccountBtn) {
        deleteAccountBtn.addEventListener('click', deleteSelectedUserAccount);
      }

      if (copyRecoveryBtn) {
        copyRecoveryBtn.addEventListener('click', copyRecoverySql);
      }

      renderCashouts();
      applyFilters();
      syncSelectionControls();

      // CAMPAIGN MANAGEMENT
      let campaigns = [];
      const campaignMeta = document.getElementById('campaignMeta');
      const campaignsList = document.getElementById('campaignsList');
      const campaignNameInput = document.getElementById('campaignName');
      const campaignSubjectInput = document.getElementById('campaignSubject');
      const campaignHtmlInput = document.getElementById('campaignHtml');
      const createCampaignBtn = document.getElementById('createCampaignBtn');
      const createStatus = document.getElementById('createStatus');
      
      const individualEmail = document.getElementById('individualEmail');
      const individualSubject = document.getElementById('individualSubject');
      const individualHtml = document.getElementById('individualHtml');
      const sendIndividualBtn = document.getElementById('sendIndividualBtn');
      const individualStatus = document.getElementById('individualStatus');

      function setCampaignStatus(message, isError = false) {
        if (createStatus) {
          createStatus.textContent = message;
          createStatus.style.color = isError ? '#ff9bb3' : '#9cc9e7';
        }
      }

      function setIndividualStatus(message, isError = false) {
        if (individualStatus) {
          individualStatus.textContent = message;
          individualStatus.style.color = isError ? '#ff9bb3' : '#9cc9e7';
        }
      }

      async function loadCampaigns() {
        try {
          const response = await fetch(`/api/campaigns/list?key=${adminKey}`);
          if (!response.ok) throw new Error('Failed to load campaigns');
          campaigns = await response.json();
          renderCampaigns();
          if (campaignMeta) {
            campaignMeta.textContent = `${campaigns.length} campaign${campaigns.length === 1 ? '' : 's'} created`;
          }
        } catch (error) {
          console.error('Failed to load campaigns', error);
          if (campaignMeta) campaignMeta.textContent = 'Error loading campaigns';
        }
      }

      function renderCampaigns() {
        if (!campaignsList) return;
        campaignsList.innerHTML = '';
        
        if (campaigns.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'cashout-empty';
          empty.textContent = 'No campaigns created yet.';
          campaignsList.appendChild(empty);
          return;
        }

        campaigns.forEach((campaign) => {
          const item = document.createElement('div');
          item.className = 'cashout-item';
          const createdDate = new Date(campaign.created_at).toLocaleDateString();
          item.innerHTML = `
            <div class="cashout-row">
              <div><strong>${campaign.name}</strong></div>
              <span class="pill">Sent ${campaign.sent_count} times</span>
            </div>
            <div class="muted">Subject: ${campaign.subject}</div>
            <div class="muted">Created ${createdDate}</div>
            <div class="cashout-actions">
              <button class="button edit-campaign" type="button" data-id="${campaign.id}">Edit</button>
              <button class="button send-campaign" type="button" data-id="${campaign.id}">Send to All Users</button>
              <button class="button delete-campaign" type="button" data-id="${campaign.id}" style="background: linear-gradient(120deg, rgba(255, 155, 179, 0.18), rgba(255, 110, 110, 0.14));">Delete</button>
            </div>
          `;
          
          const editBtn = item.querySelector('.edit-campaign');
          const sendBtn = item.querySelector('.send-campaign');
          const deleteBtn = item.querySelector('.delete-campaign');
          
          if (editBtn) editBtn.addEventListener('click', () => editCampaign(campaign));
          if (sendBtn) sendBtn.addEventListener('click', () => sendCampaignToAll(campaign.id, campaign.name));
          if (deleteBtn) deleteBtn.addEventListener('click', () => deleteCampaign(campaign.id));
          
          campaignsList.appendChild(item);
        });
      }

      async function createCampaign() {
        const name = campaignNameInput?.value?.trim();
        const subject = campaignSubjectInput?.value?.trim();
        const html_content = campaignHtmlInput?.value?.trim();

        if (!name || !subject || !html_content) {
          setCampaignStatus('Please fill in all fields.', true);
          return;
        }

        try {
          setCampaignStatus('Creating campaign...');
          const response = await fetch('/api/campaigns/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({ name, subject, html_content }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setCampaignStatus(payload.error || 'Failed to create campaign.', true);
            return;
          }
          setCampaignStatus('Campaign created successfully!');
          if (campaignNameInput) campaignNameInput.value = '';
          if (campaignSubjectInput) campaignSubjectInput.value = '';
          if (campaignHtmlInput) campaignHtmlInput.value = '';
          loadCampaigns();
        } catch (error) {
          console.error('Failed to create campaign', error);
          setCampaignStatus('Error creating campaign.', true);
        }
      }

      function editCampaign(campaign) {
        if (campaignNameInput) campaignNameInput.value = campaign.name;
        if (campaignSubjectInput) campaignSubjectInput.value = campaign.subject;
        if (campaignHtmlInput) campaignHtmlInput.value = campaign.html_content;
        
        const oldCreateClick = createCampaignBtn?.onclick;
        if (createCampaignBtn) {
          createCampaignBtn.textContent = 'Update Campaign';
          createCampaignBtn.onclick = async () => {
            const name = campaignNameInput?.value?.trim();
            const subject = campaignSubjectInput?.value?.trim();
            const html_content = campaignHtmlInput?.value?.trim();
            
            if (!name || !subject || !html_content) {
              setCampaignStatus('Please fill in all fields.', true);
              return;
            }

            try {
              setCampaignStatus('Updating campaign...');
              const response = await fetch(`/api/campaigns/update/${campaign.id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
                body: JSON.stringify({ name, subject, html_content }),
              });
              const payload = await response.json().catch(() => ({}));
              if (!response.ok) {
                setCampaignStatus(payload.error || 'Failed to update campaign.', true);
                return;
              }
              setCampaignStatus('Campaign updated successfully!');
              if (campaignNameInput) campaignNameInput.value = '';
              if (campaignSubjectInput) campaignSubjectInput.value = '';
              if (campaignHtmlInput) campaignHtmlInput.value = '';
              createCampaignBtn.textContent = 'Create Campaign';
              createCampaignBtn.onclick = null;
              loadCampaigns();
            } catch (error) {
              console.error('Failed to update campaign', error);
              setCampaignStatus('Error updating campaign.', true);
            }
          };
        }
      }

      async function sendCampaignToAll(campaignId, campaignName) {
        if (!confirm(`Send campaign "${campaignName}" to all users?`)) return;

        try {
          setCampaignStatus(`Sending campaign "${campaignName}"...`);
          const response = await fetch(`/api/campaigns/send-campaign/${campaignId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({}),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setCampaignStatus(payload.error || 'Failed to send campaign.', true);
            return;
          }
          setCampaignStatus(`Campaign sent! Delivered to ${payload.sent}/${payload.attempted} users.`);
          loadCampaigns();
        } catch (error) {
          console.error('Failed to send campaign', error);
          setCampaignStatus('Error sending campaign.', true);
        }
      }

      async function deleteCampaign(campaignId) {
        if (!confirm('Delete this campaign? This cannot be undone.')) return;

        try {
          setCampaignStatus('Deleting campaign...');
          const response = await fetch(`/api/campaigns/delete/${campaignId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({}),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setCampaignStatus(payload.error || 'Failed to delete campaign.', true);
            return;
          }
          setCampaignStatus('Campaign deleted.');
          loadCampaigns();
        } catch (error) {
          console.error('Failed to delete campaign', error);
          setCampaignStatus('Error deleting campaign.', true);
        }
      }

      async function sendIndividualEmail() {
        const email = individualEmail?.value?.trim();
        const subject = individualSubject?.value?.trim();
        const html_content = individualHtml?.value?.trim();

        if (!email || !subject || !html_content) {
          setIndividualStatus('Please fill in all fields.', true);
          return;
        }

        try {
          setIndividualStatus('Sending email...');
          const response = await fetch('/api/campaigns/send-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
            body: JSON.stringify({ email, subject, html_content }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            setIndividualStatus(payload.error || 'Failed to send email.', true);
            return;
          }
          setIndividualStatus(`Email sent to ${email}!`);
          if (individualEmail) individualEmail.value = '';
          if (individualSubject) individualSubject.value = '';
          if (individualHtml) individualHtml.value = '';
        } catch (error) {
          console.error('Failed to send email', error);
          setIndividualStatus('Error sending email.', true);
        }
      }

      if (createCampaignBtn) {
        createCampaignBtn.addEventListener('click', createCampaign);
      }

      if (sendIndividualBtn) {
        sendIndividualBtn.addEventListener('click', sendIndividualEmail);
      }

      loadCampaigns();
    </script>
  </body>
</html>
