<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#040712" />
    <title>StackJack · NeonArc</title>
    <link rel="stylesheet" href="/css/stackjack-session.css">
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@500&display=swap');

      :root {
        color-scheme: dark;
        --bg: #040712;
        --panel: rgba(10, 16, 32, 0.9);
        --glass: rgba(255, 255, 255, 0.04);
        --accent: #6ef3ff;
        --accent-2: #ff6ee6;
        --text: #eaf4ff;
        --muted: #9db3d3;
        --border: rgba(110, 243, 255, 0.22);
        --card: linear-gradient(135deg, rgba(110, 243, 255, 0.15), rgba(255, 110, 230, 0.1));
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
        background: radial-gradient(circle at 20% 18%, rgba(110, 243, 255, 0.12), transparent 28%),
          radial-gradient(circle at 70% 66%, rgba(255, 110, 230, 0.16), transparent 30%),
          var(--bg);
        color: var(--text);
        padding-bottom: 90px;
      }

      a {
        color: inherit;
      }

      header {
        padding: 18px clamp(14px, 4vw, 32px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        position: sticky;
        top: 0;
        z-index: 10;
        background: linear-gradient(180deg, rgba(4, 7, 18, 0.92), rgba(4, 7, 18, 0.7));
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .brand {
        display: grid;
        gap: 6px;
      }

      .brand h1 {
        margin: 0;
        letter-spacing: 0.12em;
        font-size: clamp(20px, 4vw, 26px);
      }

      .brand span {
        color: var(--muted);
        font-size: 14px;
      }

      .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .chip {
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: linear-gradient(115deg, rgba(110, 243, 255, 0.15), rgba(255, 110, 230, 0.1));
        text-decoration: none;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      main {
        padding: 16px clamp(14px, 4vw, 32px) 40px;
        display: grid;
        gap: 18px;
      }

      .hero {
        border: 1px solid var(--border);
        border-radius: 18px;
        background: linear-gradient(120deg, rgba(10, 16, 32, 0.95), rgba(10, 14, 26, 0.92));
        padding: 16px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 14px;
        align-items: center;
      }

      .hero h2 {
        margin: 0 0 8px;
        font-size: clamp(24px, 4.6vw, 32px);
      }

      .hero p {
        margin: 0 0 12px;
        color: var(--muted);
      }

      .friendly-stack-banner {
        margin-top: 18px;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid rgba(110, 243, 255, 0.4);
        background: rgba(110, 243, 255, 0.08);
        color: rgba(234, 249, 255, 0.92);
        letter-spacing: 0.1em;
        font-size: 14px;
      }

      .stackjack-session-panel {
        margin-top: 20px;
        padding: 14px;
        border-radius: 18px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: linear-gradient(180deg, rgba(4, 7, 18, 0.95), rgba(10, 16, 32, 0.85));
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .stackjack-participants {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 13px;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.7);
      }

      .stackjack-event-feed {
        min-height: 60px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        padding: 10px;
        background: rgba(255, 255, 255, 0.02);
        display: grid;
        gap: 6px;
        max-height: 120px;
        overflow-y: auto;
      }

      .stackjack-event-feed .stackjack-event {
        padding: 6px 10px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(255, 255, 255, 0.02);
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 13px;
      }

      .stackjack-video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 10px;
      }

      .stackjack-video-grid video {
        width: 100%;
        height: 120px;
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.7);
        object-fit: cover;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .stackjack-session-actions {
        display: flex;
        justify-content: flex-end;
      }

      .pill-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
      }

      .pill {
        padding: 8px 12px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        font-size: 14px;
      }

      .cta {
        padding: 10px 14px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(120deg, var(--accent), var(--accent-2));
        color: #050814;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-decoration: none;
        box-shadow: 0 12px 28px rgba(110, 243, 255, 0.32);
        display: inline-flex;
        gap: 8px;
        align-items: center;
      }

      .table-shell {
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 14px;
        background: var(--panel);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
        display: grid;
        gap: 12px;
      }

      .table-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .meta-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .badge {
        padding: 8px 12px;
        border-radius: 12px;
        background: var(--glass);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--muted);
        font-size: 14px;
      }

      .bank-box {
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 10px 12px;
        background: linear-gradient(120deg, rgba(110, 243, 255, 0.18), rgba(255, 110, 230, 0.12));
        color: #04111e;
        font-weight: 800;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .table-body {
        border: 1px dashed rgba(255, 255, 255, 0.14);
        border-radius: 14px;
        padding: 12px;
        background: radial-gradient(circle at 40% 20%, rgba(110, 243, 255, 0.12), transparent 50%),
          radial-gradient(circle at 70% 80%, rgba(255, 110, 230, 0.12), transparent 55%),
          rgba(255, 255, 255, 0.02);
        display: grid;
        gap: 12px;
      }

      .hand {
        display: grid;
        gap: 8px;
        padding: 10px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
      }

      .hand-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
      }

      .tag {
        padding: 6px 10px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--muted);
        font-size: 13px;
      }

      .cards {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .card {
        width: 64px;
        height: 90px;
        border-radius: 10px;
        padding: 8px 10px;
        background: var(--card);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.32);
        display: grid;
        grid-template-rows: auto 1fr auto;
        font-weight: 800;
        color: #f2fbff;
      }

      .card.red {
        color: #ffc7d8;
      }

      .card.back {
        background: linear-gradient(120deg, #111a30, #0a0f24);
        border: 1px solid rgba(110, 243, 255, 0.35);
        justify-items: center;
        align-items: center;
        font-size: 18px;
      }

      .card .suit {
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.02em;
        font-size: 13px;
      }

      .total {
        font-weight: 800;
        letter-spacing: 0.05em;
      }

      .wager {
        display: grid;
        gap: 8px;
        background: rgba(255, 255, 255, 0.02);
        padding: 10px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.06);
      }

      .wager-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .range {
        width: 100%;
        accent-color: var(--accent);
      }

      .action-bar {
        position: sticky;
        bottom: 8px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 8px;
        background: rgba(4, 7, 18, 0.94);
        padding: 10px;
        border-radius: 12px;
        border: 1px solid var(--border);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
      }

      button {
        border: none;
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 800;
        letter-spacing: 0.06em;
        cursor: pointer;
        color: #050814;
        background: linear-gradient(120deg, var(--accent), var(--accent-2));
        box-shadow: 0 12px 28px rgba(110, 243, 255, 0.28);
        transition: transform 0.15s ease, opacity 0.2s ease;
      }

      button.secondary {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
        box-shadow: none;
        border: 1px solid rgba(255, 255, 255, 0.06);
      }

      button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
      }

      button:not(:disabled):active {
        transform: translateY(1px);
      }

      .log {
        background: rgba(0, 0, 0, 0.28);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 10px;
        color: var(--muted);
        font-size: 14px;
        display: grid;
        gap: 6px;
      }

      .tips {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      .tip {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 12px;
        background: rgba(255, 255, 255, 0.02);
        color: var(--muted);
      }

      .tip strong {
        color: var(--text);
      }

      @media (max-width: 840px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .cards {
          justify-content: flex-start;
        }

        .action-bar {
          grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        }
      }

      @media (max-width: 540px) {
        header {
          flex-direction: column;
          align-items: flex-start;
        }

        .table-body {
          padding: 10px;
        }

        .card {
          width: 58px;
          height: 82px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="brand">
        <h1>StackJack</h1>
        <span>Solo table tuned for phones and tablets</span>
      </div>
      <div class="header-actions">
        <a class="chip" href="/app">Back to NeonArc</a>
        <a class="chip" href="/login">Login</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div>
          <h2>Stack cards, double fast, never hide the thumb zone.</h2>
          <p>
            StackJack runs a streamlined single seat blackjack table with a stack (double) action built into
            the thumb bar. It was rebuilt for portrait play, safe areas, and quick restarts so you can keep a
            streak alive while commuting.
          </p>
          <div class="pill-row">
            <span class="pill">Stack = double bet + one card</span>
            <span class="pill">Portrait-first controls</span>
            <span class="pill">Auto reshuffle when the shoe runs low</span>
          </div>
        </div>
        <div class="pill-row">
          <a class="cta" href="#table">Play the table</a>
          <span class="pill">Balance stays on this device</span>
        </div>
      </section>

      <div class="friendly-stack-banner" id="stackFriendlyBanner" hidden>
        <p id="stackFriendlyMessage">Share this session with a friend and face the computer together.</p>
      </div>

      <%- include('partials/stackjack-session-panel') %>

      <article id="table" class="table-shell">
        <div class="table-top">
          <div class="meta-row">
            <span class="badge" id="shoeCount">Shoe: 52</span>
            <span class="badge" id="streakBadge">Streak: 0</span>
            <span class="badge" id="bestBadge">Best: 0</span>
          </div>
          <div class="bank-box">
            <span>Balance</span>
            <span id="bankrollDisplay">$0</span>
            <button id="resetBank" class="secondary" style="padding: 8px 10px">Reset</button>
          </div>
        </div>

        <div class="table-body">
          <div class="hand">
            <div class="hand-header">
              <div class="tag">Dealer</div>
              <div class="total" id="dealerTotal">?</div>
            </div>
            <div class="cards" id="dealerCards"></div>
          </div>

          <div class="hand">
            <div class="hand-header">
              <div class="tag">You</div>
              <div class="total" id="playerTotal">0</div>
            </div>
            <div class="cards" id="playerCards"></div>
          </div>

          <div class="wager">
            <div class="wager-row">
              <strong>Wager</strong>
              <span id="betLabel">$25</span>
            </div>
            <input id="betRange" class="range" type="range" min="5" max="250" step="5" value="25" />
            <div class="wager-row">
              <small style="color: var(--muted)">Move this before dealing. Stack doubles this amount.</small>
              <div style="display: flex; gap: 6px">
                <button class="secondary" id="quickMin" style="padding: 8px 10px">Min</button>
                <button class="secondary" id="quickMax" style="padding: 8px 10px">Max</button>
              </div>
            </div>
          </div>
        </div>

        <div class="action-bar">
          <button id="dealBtn">Deal</button>
          <button id="hitBtn" class="secondary" disabled>Hit</button>
          <button id="stackBtn" disabled>Stack (x2)</button>
          <button id="standBtn" class="secondary" disabled>Stand</button>
        </div>

        <div class="log" id="log">
          <div><strong>Round log</strong></div>
          <div id="logMessage">Tap Deal to begin.</div>
        </div>
      </article>

      <section class="tips">
        <div class="tip">
          <strong>Stack move</strong><br />Stacks double your wager, pull one more card, and stand
          immediately—designed for quick upside when you like your opening two.
        </div>
        <div class="tip">
          <strong>Auto safety</strong><br />The shoe reshuffles when low to keep runs smooth. Your balance is
          stored locally so mobile play never blocks on a network call.
        </div>
        <div class="tip">
          <strong>Thumb-first bar</strong><br />The action bar pins to the bottom on mobile so Hit and Stack
          stay inside the thumb arc, even with the notch or home bar.
        </div>
      </section>
    </main>

    <script src="/js/stackjack-session.js"></script>
    <script>
      const suits = [
        { key: 'hearts', symbol: '♥', red: true },
        { key: 'diamonds', symbol: '♦', red: true },
        { key: 'clubs', symbol: '♣', red: false },
        { key: 'spades', symbol: '♠', red: false },
      ];
      const ranks = [
        { label: 'A', value: 11 },
        { label: '2', value: 2 },
        { label: '3', value: 3 },
        { label: '4', value: 4 },
        { label: '5', value: 5 },
        { label: '6', value: 6 },
        { label: '7', value: 7 },
        { label: '8', value: 8 },
        { label: '9', value: 9 },
        { label: '10', value: 10 },
        { label: 'J', value: 10 },
        { label: 'Q', value: 10 },
        { label: 'K', value: 10 },
      ];

      let deck = [];
      let playerHand = [];
      let dealerHand = [];
      let dealerHidden = true;
      let roundActive = false;
      let bankroll = Number(localStorage.getItem('stackjack.bankroll')) || 500;
      let wager = Number(localStorage.getItem('stackjack.wager')) || 25;
      let liveBet = wager;
      let streak = Number(localStorage.getItem('stackjack.streak')) || 0;
      let best = Number(localStorage.getItem('stackjack.best')) || 0;

      const dealerCardsEl = document.getElementById('dealerCards');
      const playerCardsEl = document.getElementById('playerCards');
      const dealerTotalEl = document.getElementById('dealerTotal');
      const playerTotalEl = document.getElementById('playerTotal');
      const betLabelEl = document.getElementById('betLabel');
      const betRangeEl = document.getElementById('betRange');
      const bankEl = document.getElementById('bankrollDisplay');
      const shoeCountEl = document.getElementById('shoeCount');
      const streakBadge = document.getElementById('streakBadge');
      const bestBadge = document.getElementById('bestBadge');
      const logMessage = document.getElementById('logMessage');
      const dealBtn = document.getElementById('dealBtn');
      const hitBtn = document.getElementById('hitBtn');
      const standBtn = document.getElementById('standBtn');
      const stackBtn = document.getElementById('stackBtn');
      const quickMin = document.getElementById('quickMin');
      const quickMax = document.getElementById('quickMax');
      const resetBank = document.getElementById('resetBank');

      const saveState = () => {
        localStorage.setItem('stackjack.bankroll', bankroll);
        localStorage.setItem('stackjack.wager', wager);
        localStorage.setItem('stackjack.streak', streak);
        localStorage.setItem('stackjack.best', best);
      };

      const buildDeck = () => {
        const fresh = [];
        suits.forEach((suit) => {
          ranks.forEach((rank) => {
            fresh.push({
              label: rank.label,
              value: rank.value,
              suit,
              hidden: false,
              id: `${rank.label}${suit.key}${Math.random().toString(16).slice(2, 6)}`,
            });
          });
        });
        return shuffle([...fresh, ...fresh]);
      };

      const shuffle = (array) => {
        for (let i = array.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
      };

      const drawCard = () => {
        if (deck.length <= 6) {
          deck = buildDeck();
          setLog('Shoe reshuffled.');
        }
        return deck.pop();
      };

      const handTotal = (hand, revealHidden = false) => {
        let total = 0;
        let aces = 0;
        hand.forEach((card) => {
          if (card.hidden && !revealHidden) return;
          total += card.value;
          if (card.label === 'A') aces++;
        });
        while (total > 21 && aces > 0) {
          total -= 10;
          aces -= 1;
        }
        return total;
      };

      const renderHand = (container, hand, isDealer = false) => {
        container.innerHTML = '';
        hand.forEach((card) => {
          const cardEl = document.createElement('div');
          cardEl.className = `card ${card.suit.red ? 'red' : ''} ${card.hidden && isDealer ? 'back' : ''}`;
          if (card.hidden && isDealer) {
            cardEl.textContent = '🜨';
          } else {
            cardEl.innerHTML = `
              <div>${card.label}</div>
              <div class="suit">${card.suit.symbol}</div>
              <div style="text-align:right">${card.label}</div>
            `;
          }
          container.appendChild(cardEl);
        });
      };

      const setLog = (text) => {
        logMessage.textContent = text;
      };

      const updateBadges = () => {
        streakBadge.textContent = `Streak: ${streak}`;
        bestBadge.textContent = `Best: ${best}`;
      };

      const updateUI = () => {
        renderHand(dealerCardsEl, dealerHand, true);
        renderHand(playerCardsEl, playerHand);

        const dealerVisible = dealerHidden ? `${handTotal(dealerHand, false)} + ?` : handTotal(dealerHand, true);
        dealerTotalEl.textContent = dealerHand.length ? dealerVisible : '?';
        playerTotalEl.textContent = handTotal(playerHand, true);

        betLabelEl.textContent = `$${wager}`;
        betRangeEl.value = wager;
        bankEl.textContent = `$${bankroll}`;
        shoeCountEl.textContent = `Shoe: ${deck.length} cards`;
        updateBadges();

        hitBtn.disabled = !roundActive;
        standBtn.disabled = !roundActive;
        stackBtn.disabled = !roundActive || playerHand.length !== 2 || bankroll < liveBet;
        dealBtn.disabled = roundActive;
      };

      const resetHands = () => {
        playerHand = [];
        dealerHand = [];
        dealerHidden = true;
      };

      const revealDealer = () => {
        dealerHidden = false;
        dealerHand = dealerHand.map((card) => ({ ...card, hidden: false }));
      };

      const startRound = () => {
        if (roundActive) return;
        if (bankroll < wager) {
          setLog('Not enough balance for that wager. Lower it or reset balance.');
          return;
        }

        resetHands();
        liveBet = wager;
        bankroll -= liveBet;
        roundActive = true;
        dealerHand.push({ ...drawCard(), hidden: true });
        dealerHand.push(drawCard());
        playerHand.push(drawCard());
        playerHand.push(drawCard());

        const playerTotal = handTotal(playerHand, true);
        if (playerTotal === 21) {
          // Natural blackjack pays 3:2
          settleRound('blackjack');
          return;
        }

        setLog(`Wagered $${liveBet}. Choose Hit, Stack, or Stand.`);
        updateUI();
      };

      const playerHit = () => {
        if (!roundActive) return;
        playerHand.push(drawCard());
        const total = handTotal(playerHand, true);
        if (total > 21) {
          settleRound('playerBust');
        } else {
          setLog(`You drew a ${playerHand[playerHand.length - 1].label}. Total: ${total}.`);
          updateUI();
        }
      };

      const stackMove = () => {
        if (!roundActive || playerHand.length !== 2) return;
        if (bankroll < liveBet) {
          setLog('Need enough balance to double. Lower wager or reset.');
          return;
        }
        bankroll -= liveBet;
        liveBet *= 2;
        playerHand.push(drawCard());
        const total = handTotal(playerHand, true);
        setLog(`Stacked to $${liveBet}. Final card brings you to ${total}.`);
        updateUI();
        stand(true);
      };

      const stand = (fromStack = false) => {
        if (!roundActive) return;
        dealerHidden = false;
        dealerHand = dealerHand.map((card) => ({ ...card, hidden: false }));

        while (handTotal(dealerHand, true) < 17) {
          dealerHand.push(drawCard());
        }
        settleRound(fromStack ? 'stackStand' : 'stand');
      };

      const settleRound = (reason) => {
        revealDealer();
        const playerTotal = handTotal(playerHand, true);
        const dealerTotal = handTotal(dealerHand, true);
        let payout = 0;
        let message = '';

        if (reason === 'blackjack') {
          payout = Math.floor(liveBet * 2.5);
          streak += 1;
          message = `Blackjack! Paid $${payout}.`;
        } else if (playerTotal > 21) {
          streak = 0;
          message = `Bust at ${playerTotal}. Dealer wins.`;
        } else if (dealerTotal > 21) {
          payout = liveBet * 2;
          streak += 1;
          message = `Dealer busts at ${dealerTotal}. You win $${payout - liveBet}.`;
        } else if (playerTotal > dealerTotal) {
          payout = liveBet * 2;
          streak += 1;
          message = `You beat the dealer ${playerTotal} to ${dealerTotal}. Win $${payout - liveBet}.`;
        } else if (playerTotal === dealerTotal) {
          payout = liveBet;
          message = `Push at ${playerTotal}. Bet returned.`;
        } else {
          streak = 0;
          message = `Dealer shows ${dealerTotal} over your ${playerTotal}.`;
        }

        bankroll += payout;
        best = Math.max(best, streak);
        roundActive = false;
        saveState();
        setLog(message);
        updateUI();
        window.stackjackSession?.sendEvent({
          event: 'round.result',
          result: reason,
          playerTotal,
          dealerTotal,
          payout,
          message,
        });
      };

      betRangeEl.addEventListener('input', (e) => {
        wager = Number(e.target.value);
        saveState();
        updateUI();
      });

      quickMin.addEventListener('click', () => {
        wager = 5;
        updateUI();
        saveState();
      });

      quickMax.addEventListener('click', () => {
        wager = Math.min(250, bankroll);
        wager = Math.max(wager, 5);
        updateUI();
        saveState();
      });

      resetBank.addEventListener('click', () => {
        bankroll = 500;
        streak = 0;
        best = Math.max(best, streak);
        saveState();
        setLog('Bankroll reset to $500.');
        updateUI();
      });

      dealBtn.addEventListener('click', startRound);
      hitBtn.addEventListener('click', playerHit);
      standBtn.addEventListener('click', () => stand(false));
      stackBtn.addEventListener('click', stackMove);

      // Initialize deck and UI
      deck = buildDeck();
      updateUI();
      setLog('Tap Deal to begin.');
      const stackFriendlyBanner = document.getElementById('stackFriendlyBanner');
      const stackFriendlyMessage = document.getElementById('stackFriendlyMessage');
      const stackFriendParam = new URLSearchParams(window.location.search).get('friend')?.trim();
      if (stackFriendParam) {
        if (stackFriendlyMessage) {
          stackFriendlyMessage.textContent = `Sharing this StackJack table with ${stackFriendParam}.`;
        }
        if (stackFriendlyBanner) {
          stackFriendlyBanner.hidden = false;
        }
        setLog(`Friendly match with ${stackFriendParam}.`);
      }
    </script>
  </body>
</html>
